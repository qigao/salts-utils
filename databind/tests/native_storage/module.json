{
  "targets": {
    "test_data_bind_native_bytes_json": {
      "kind": "executable",
      "sources": {
        "files": [
          "native_bytes_json_test.c"
        ]
      },
      "test": {
        "labels": [
          "bytes",
          "cmeta",
          "databind",
          "json",
          "native"
        ],
        "timeout": 60
      },
      "when": {
        "native": true
      },
      "private": {
        "includeDirs": [
          "../../runtime",
          "../../schema/include",
          "../../formats/binary/include"
        ],
        "deps": [
          "data_bind",
          "cmeta_cstl",
          "saltsbase_tinytest",
          "saltsbase_cserde",
          "cmeta_cflow",
          "cmeta_cmeta",
          "saltsbase_native_io",
          "saltsbase_coroutine",
          "saltsbase_core"
        ],
        "libs": [
          "ws2_32"
        ]
      },
      "variants": [
        {
          "when": {
            "driver": "msvc"
          },
          "private": {
            "flags": [
              "/experimental:c11atomics"
            ]
          }
        },
        {
          "when": {
            "os": [
              "linux",
              "macos",
              "android"
            ]
          },
          "private": {
            "defines": {
              "_POSIX_C_SOURCE": "200809L"
            }
          }
        }
      ]
    },
