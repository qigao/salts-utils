schema Device [version(1)];

message TelemetryEvent {
  uint32 sequence;
  string source;
}

channel Telemetry: TelemetryEvent;

union Choice {
  TelemetryEvent event;
}

channel ChoiceEvents: Choice;

channel Raw: bytes;


message AddRequest {
  uint32 value;
}

message AddResponse {
  uint32 value;
}

message CalcError {
  uint32 code;
}

service Calc {
  Add: AddRequest -> AddResponse throws CalcError;
  Choose: AddRequest -> Choice;
}

