schema MessageNativeArtifact [version(1)];

message Event {
  uint32 id;
  optional uint32 sequence;
  nullable uint32 result;
  optional nullable uint32 tri;
  list<uint32> values;
  list<string> labels;
  set<uint32> ids;
  set<string> tags;
  map<string,uint32> counters;
  map<string,string> aliases;
}


message OverlayContainers {
  optional list<uint32> values;
  nullable set<string> tags;
  optional nullable map<string,uint32> attrs;
}
