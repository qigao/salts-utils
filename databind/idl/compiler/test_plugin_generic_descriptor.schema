schema GenericPlugin [version(1)];

component GenericProcessor {
    service GenericService;
}

message GenericItem {
    uint32 id;
}

message GenericRequest {
    list<GenericItem> values;
}

message GenericResponse {
    map<string,GenericItem> values;
}

service GenericService {
    Inspect: GenericRequest -> GenericResponse;
}
