schema Device [version(1)];

message TelemetryEvent {
  uint32 sequence;
  optional uint32 sample;
  nullable uint32 result;
  optional nullable uint32 tri;
  string source;
}

channel Telemetry: TelemetryEvent;

union Choice {
  TelemetryEvent event;
}

channel ChoiceEvents: Choice;

channel Raw: bytes;
