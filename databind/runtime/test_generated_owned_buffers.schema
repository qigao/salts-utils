schema NativeOwnedBuffers [id(1), version(1), byte_order(little)];

[id(1)]
message NativeOwnedBufferRecord {
    uint32 id;
    string text;
    bytes payload;
}

composite NativeHeader {
    string name;
    string value;
}

message NativeHeaderPolicy {
    uint32 id;
    list<NativeHeader> headers;
}
