schema NativeOwnedBuffers [id(1), version(1), byte_order(little)];

[id(1)]
message NativeOwnedBufferRecord {
    uint32 id;
    string text;
    bytes payload;
}

message NativeHeader {
    @Size(min = 1, max = 32)
    @Pattern("[a-z-]+")
    string name;
    @Size(min = 1, max = 64)
    string value;
}

message NativeHeaderPolicy {
    uint32 id;
    @Size(max = 3)
    list<NativeHeader> headers;
}
