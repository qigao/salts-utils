schema Graph;
enum State <int16> { Idle = 0; Ready = 7; }
composite Point { int32 x; double y; }
message Sample { Point point; State state; [name("wire_count"), alias("old_count")] int32 count default 9; }
message Unsupported { int32 good; string bad; }
message OptionalStorage { optional int32 value; }
message UnsupportedNested { Unsupported child; }

flags Permission <uint8> { Read = 1; Write = 2; }
enum Signed8Domain <int8> { Minimum = -128; Maximum = 127; }
enum Unsigned8Domain <uint8> { Zero = 0; Maximum = 255; }
enum Signed64Domain <int64> { Minimum = -9223372036854775808; Maximum = 9223372036854775807; }
enum WideDomain <uint64> { Zero = 0; Maximum = 18446744073709551615; }
// Public item names must never collide with compiler-owned enum machinery.
enum EnumSymbols <uint16> {
    CMETA_DOMAIN = 1; CMETA_ENUM_OPS = 2; CMETA_BITS_OPS = 3;
    CMETA_DATA = 4; CMETA_TYPE = 5; CMETA_ID = 6; CMETA_ITEMS = 7;
    cmeta_is_zero = 8; cmeta_read = 9; cmeta_assign = 10; cmeta_restore_zero = 11;
}
message EnumSymbolStorage { EnumSymbols value; }
message FlagStorage { Permission value; }
message Signed8Storage { Signed8Domain value; }
message Unsigned8Storage { Unsigned8Domain value; }
message Signed64Storage { Signed64Domain value; }
message BoolStorage { bool value; }
message IntegerBoolDefaults { uint8 enabled default true; int32 debug default false; }
message FixedValues { bool enabled; uuid id; bytes(16) digest; }
message FixedOwnedFields { bytes(16) digest; string label; }
message FixedOwnedEnvelope { optional FixedOwnedFields child; bytes payload; }
message WideEnumStorage { WideDomain value; }
message UuidStorage { uuid value; }
message BytesStorage { bytes value; }
message ListStorage { list<int32> value; }
message SetStorage { set<int32> value; }
message MapStorage { map<string,int32> value; }
message Scalars {
    int8_t s8a; int8 s8b; i8 s8c;
    int16_t s16a; int16 s16b; i16 s16c;
    int32_t s32a; int32 s32b; i32 s32c;
    int64_t s64a; int64 s64b; i64 s64c;
    uint8_t u8a; uint8 u8b; u8 u8c; byte octet;
    uint16_t u16a; uint16 u16b; u16 u16c;
    uint32_t u32a; uint32 u32b; u32 u32c;
    uint64_t u64a; uint64 u64b; u64 u64c;
    float f32a; f32 f32b; double f64a; f64 f64b;
}

// Adjacent native-record depth boundary: Depth32 succeeds, Depth33 rejects.
composite Depth0 { int32 value; }
composite Depth1 { Depth0 child; }
composite Depth2 { Depth1 child; }
composite Depth3 { Depth2 child; }
composite Depth4 { Depth3 child; }
composite Depth5 { Depth4 child; }
composite Depth6 { Depth5 child; }
composite Depth7 { Depth6 child; }
composite Depth8 { Depth7 child; }
composite Depth9 { Depth8 child; }
composite Depth10 { Depth9 child; }
composite Depth11 { Depth10 child; }
composite Depth12 { Depth11 child; }
composite Depth13 { Depth12 child; }
composite Depth14 { Depth13 child; }
composite Depth15 { Depth14 child; }
composite Depth16 { Depth15 child; }
composite Depth17 { Depth16 child; }
composite Depth18 { Depth17 child; }
composite Depth19 { Depth18 child; }
composite Depth20 { Depth19 child; }
composite Depth21 { Depth20 child; }
composite Depth22 { Depth21 child; }
composite Depth23 { Depth22 child; }
composite Depth24 { Depth23 child; }
composite Depth25 { Depth24 child; }
composite Depth26 { Depth25 child; }
composite Depth27 { Depth26 child; }
composite Depth28 { Depth27 child; }
composite Depth29 { Depth28 child; }
composite Depth30 { Depth29 child; }
composite Depth31 { Depth30 child; }
composite Depth32 { Depth31 child; }
composite Depth33 { Depth32 child; }

// Owned messages exercise local lifecycle past the graph-publication limit.
message OwnedDepth0 { int32 value; string label; bytes payload; }
message OwnedDepth1 { OwnedDepth0 child; }
message OwnedDepth2 { OwnedDepth1 child; }
message OwnedDepth3 { OwnedDepth2 child; }
message OwnedDepth4 { OwnedDepth3 child; }
message OwnedDepth5 { OwnedDepth4 child; }
message OwnedDepth6 { OwnedDepth5 child; }
message OwnedDepth7 { OwnedDepth6 child; }
message OwnedDepth8 { OwnedDepth7 child; }
message OwnedDepth9 { OwnedDepth8 child; }
message OwnedDepth10 { OwnedDepth9 child; }
message OwnedDepth11 { OwnedDepth10 child; }
message OwnedDepth12 { OwnedDepth11 child; }
message OwnedDepth13 { OwnedDepth12 child; }
message OwnedDepth14 { OwnedDepth13 child; }
message OwnedDepth15 { OwnedDepth14 child; }
message OwnedDepth16 { OwnedDepth15 child; }
message OwnedDepth17 { OwnedDepth16 child; }
message OwnedDepth18 { OwnedDepth17 child; }
message OwnedDepth19 { OwnedDepth18 child; }
message OwnedDepth20 { OwnedDepth19 child; }
message OwnedDepth21 { OwnedDepth20 child; }
message OwnedDepth22 { OwnedDepth21 child; }
message OwnedDepth23 { OwnedDepth22 child; }
message OwnedDepth24 { OwnedDepth23 child; }
message OwnedDepth25 { OwnedDepth24 child; }
message OwnedDepth26 { OwnedDepth25 child; }
message OwnedDepth27 { OwnedDepth26 child; }
message OwnedDepth28 { OwnedDepth27 child; }
message OwnedDepth29 { OwnedDepth28 child; }
message OwnedDepth30 { OwnedDepth29 child; }
message OwnedDepth31 { OwnedDepth30 child; }
message OwnedDepth32 { OwnedDepth31 child; }
message OwnedDepth33 { OwnedDepth32 child; }
message OwnedDepth34 { optional OwnedDepth33 child; nullable string note; }
