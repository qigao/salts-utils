{
  "version": 6,
  "include": [
    "CMakePresets.json"
  ],
  "configurePresets": [
    {
      "name": "ci-native-release-user",
      "inherits": "consumer-release",
      "binaryDir": "${sourceDir}/build/native",
      "toolchainFile": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/cmake/QigaoVcpkgToolchain.cmake",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "VCPKG_INSTALL_OPTIONS": "--only-binarycaching",
        "VCPKG_TARGET_TRIPLET": "$env{QIGAO_TARGET_TRIPLET}",
        "VCPKG_HOST_TRIPLET": "$env{QIGAO_TARGET_TRIPLET}",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/installed-plugin/release"
      },
      "environment": {
        "PKG_ROOT": "${sourceDir}/stage",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "SALTS_ROOT": "$penv{SALTS_ROOT}",
        "SALTS_UTILS_ROOT": "$penv{SALTS_UTILS_ROOT}",
        "PATH": "${sourceDir}/build/native/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
        "DYLD_LIBRARY_PATH": "$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$penv{DYLD_LIBRARY_PATH}"
      }
    },
    {
      "name": "win-release-user",
      "description": "Local Windows execution against the explicit SALTS_UTILS_ROOT staging SDK.",
      "inherits": "ci-native-release-user",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "VCPKG_ROOT": "$penv{VCPKG_ROOT}",
        "PKG_ROOT": "$penv{PROJECT_ROOT}/external/pkgs",
        "SALTS_ROOT": "$penv{SALTS_ROOT}",
        "QIGAO_TARGET_TRIPLET": "x64-windows",
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{LOCALAPPDATA}/qigao/vcpkg-cache",
        "VCPKG_OVERLAY_PORTS": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/ports",
        "VCPKG_BINARY_SOURCES": "clear;default,readwrite;nugettimeout,1800;nugetconfig,${sourceDir}/../../../../cmake/vcpkg-cache.nuget.config,read"
      },
      "cacheVariables": {
        "VCPKG_INSTALL_OPTIONS": ""
      }
    },
    {
      "name": "ci-android-release-user",
      "description": "Compile target consumers using the completed host salts-idlc preset build.",
      "inherits": "ci-native-release-user",
      "binaryDir": "${sourceDir}/build/android",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Android",
        "VCPKG_HOST_TRIPLET": "$env{QIGAO_HOST_TRIPLET}",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26",
        "ANDROID_STL": "c++_shared",
        "SaltsUtils_IDLC_EXECUTABLE": "$env{SALTS_UTILS_HOST_IDLC}",
        "SaltsUtils_IDLC_HOST_SALTS_ROOT": "$env{SALTS_HOST_ROOT}"
      },
      "environment": {
        "ANDROID_NDK_HOME": "$penv{ANDROID_NDK_HOME}"
      }
    },
    {
      "name": "ci-ios-release-user",
      "inherits": "ci-native-release-user",
      "binaryDir": "${sourceDir}/build/ios",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "$env{QIGAO_IOS_SYSROOT}",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "VCPKG_HOST_TRIPLET": "$env{QIGAO_HOST_TRIPLET}",
        "SaltsUtils_IDLC_EXECUTABLE": "$env{SALTS_UTILS_HOST_IDLC}",
        "SaltsUtils_IDLC_HOST_SALTS_ROOT": "$env{SALTS_HOST_ROOT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ci-native-release-user",
      "configurePreset": "ci-native-release-user"
    },
    {
      "name": "win-release-user",
      "configurePreset": "win-release-user"
    },
    {
      "name": "ci-android-release-user",
      "configurePreset": "ci-android-release-user"
    },
    {
      "name": "ci-ios-release-user",
      "configurePreset": "ci-ios-release-user"
    }
  ],
  "testPresets": [
    {
      "name": "ci-native-release-user",
      "configurePreset": "ci-native-release-user",
      "execution": {
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win-release-user",
      "configurePreset": "win-release-user",
      "execution": {
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
