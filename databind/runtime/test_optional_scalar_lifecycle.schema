schema ScalarLifecycle [id(2), version(1), byte_order(little)];

enum State <uint8> { Idle = 0; Active = 7; }
enum SignedState <int8> { Negative = -1; Zero = 0; }
flags Permissions <uint8> { Read = 1; Write = 2; }
enum WideState <uint64> { Maximum = 18446744073709551615; }
enum DefaultState { Zero; One; Two = 0x2; }

[id(1)]
message ScalarState {
    optional int32 optional_value;
    nullable uint32 nullable_value;
    optional nullable uint32 tri_value;
}

[id(2)]
message OwnedState {
    uint32 count;
    optional string label;
    nullable string note;
    optional nullable string tri_value;
}

[id(3)]
message OwnedBytesState {
    uint32 count;
    optional bytes payload;
    nullable bytes note;
    optional nullable bytes tri_value;
}

[id(4)]
message MapState {
    optional map<string,uint32> attrs;
}

[id(5)]
message FixedBytesState {
    optional bytes(16) payload;
    nullable bytes(8) note;
}

[id(6)]
message NestedValue {
    uint32 id;
}

[id(7)]
message NestedHolder {
    NestedValue child;
}

[id(8)]
message OwnedChild {
    string label;
}

[id(9)]
message NestedOwnedState {
    optional OwnedChild child;
    nullable uint32 note;
}

[id(10)]
message EnumState {
    optional State optional_value;
    nullable State nullable_value;
    optional nullable State tri_value;
}

[id(11)]
message UuidState {
    optional uuid optional_value;
    nullable uuid nullable_value;
    optional nullable uuid tri_value;
}

composite LocalPoint {
    uint32 id;
}

[id(12)]
message CompositeHolder {
    LocalPoint child;
}

[id(13)]
message EnumHolder {
    State value;
}

[id(14)]
message SignedEnumHolder {
    SignedState value;
}

[id(15)]
message FlagsHolder {
    Permissions value;
}

[id(16)]
message WideEnumHolder {
    WideState value;
}

[id(17)]
message DefaultEnumHolder {
    DefaultState value;
}

[id(18)]
message OverlayHolder {
    OwnedState text;
    OwnedBytesState bytes;
}

[id(19)]
message OverlayEnvelope {
    optional OverlayHolder child;
    nullable string note;
}
