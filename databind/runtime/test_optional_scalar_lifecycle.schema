schema ScalarLifecycle [id(2), version(1), byte_order(little)];

[id(1)]
message ScalarState {
    optional int32 optional_value;
    nullable uint32 nullable_value;
    optional nullable uint32 tri_value;
}

[id(2)]
message OwnedState {
    uint32 count;
    optional string label;
    nullable string note;
    optional nullable string tri_value;
}
