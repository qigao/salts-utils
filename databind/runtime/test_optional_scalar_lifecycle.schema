schema ScalarLifecycle [id(2), version(1), byte_order(little)];

[id(1)]
message ScalarState {
    optional int32 optional_value;
    nullable uint32 nullable_value;
    optional nullable uint32 tri_value;
}

[id(2)]
message OwnedState {
    uint32 count;
    optional string label;
    nullable string note;
    optional nullable string tri_value;
}

[id(3)]
message OwnedBytesState {
    uint32 count;
    optional bytes payload;
    nullable bytes note;
    optional nullable bytes tri_value;
}

[id(4)]
message MapState {
    optional map<string,uint32> attrs;
}

[id(5)]
message FixedBytesState {
    optional bytes(16) payload;
    nullable bytes(8) note;
}

[id(6)]
message NestedValue {
    uint32 id;
}

[id(7)]
message NestedHolder {
    NestedValue child;
}

[id(8)]
message OwnedChild {
    string label;
}

[id(9)]
message NestedOwnedState {
    optional OwnedChild child;
    nullable uint32 note;
}
