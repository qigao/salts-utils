schema Tail [id(1), version(1), byte_order(little)];

// An unreferenced CMeta record must not pull in the legacy typed header.
composite UnusedPoint {
    int32 x;
}

[id(1)]
message TailOnly {
    string text;
}

[id(2)]
message MixedWire {
    uint64 number;
    int16 delta;
    string text;
    bytes payload;
}

composite WirePoint {
    int16 delta;
    uint64 number;
}

composite WireRecord {
    WirePoint point;
    uint16 code;
}

[id(3)]
message NestedWire {
    WireRecord record;
    string text;
}

group WireEntry {
    uint16 code;
    uint32 amount;
}

[id(4)]
message GroupWire {
    uint16 id;
    group<WireEntry> entries;
    string text;
}

[id(5)]
message NullableGroupWire {
    optional nullable group<WireEntry> entries;
    string text;
}

group OwnedEntry {
    string label;
}

[id(6)]
message OwnedGroup {
    group<OwnedEntry> entries;
}

group NestedEntry {
    WirePoint point;
    uint16 code;
}

[id(7)]
message MultiGroupWire {
    group<NestedEntry> first;
    group<WireEntry> second;
    string text;
}

composite FixedByteRecord {
    bytes(6) digest;
    uint16 code;
}

[id(8)]
message FixedByteWire {
    FixedByteRecord record;
    string text;
}

[id(9)]
message NullableFixedByteWire {
    optional nullable bytes(6) digest;
    string text;
}

group FixedByteEntry {
    bytes(6) digest;
    uint16 code;
}

[id(10)]
message FixedByteGroupWire {
    group<FixedByteEntry> entries;
    string text;
}

message ScalarArrayWire {
    bool[2] ready;
    int16[3] deltas;
    float[2] ratios;
    optional nullable uint16[3] samples;
}

composite ArrayWireBlock {
    uint16[2] values;
}

message RecordArrayWire {
    optional nullable FixedByteRecord[2] records;
    ArrayWireBlock[2] blocks;
    string text;
}

group ArrayGroupEntry {
    uint16[2] values;
}

message ArrayGroupWire {
    group<ArrayGroupEntry> entries;
    string text;
}

message CountedWire {
    uint16 prefix;
    list<uint16> values;
    set<string> tags;
    map<string,string> labels;
    uint16 last;
}

message CountedRecordWire {
    list<WireRecord> records;
    uint16 last;
}

// A variable nested record has no admitted fixed inline Binary representation.
message UnavailableNested {
    TailOnly child;
}
