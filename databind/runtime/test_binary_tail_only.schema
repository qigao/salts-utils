schema Tail [id(1), version(1), byte_order(little)];

// An unreferenced CMeta record must not pull in the legacy typed header.
composite UnusedPoint {
    int32 x;
}

[id(1)]
message TailOnly {
    string text;
}

[id(2)]
message MixedWire {
    uint64 number;
    int16 delta;
    string text;
    bytes payload;
}

composite WirePoint {
    int16 delta;
    uint64 number;
}

composite WireRecord {
    WirePoint point;
    uint16 code;
}

[id(3)]
message NestedWire {
    WireRecord record;
    string text;
}
