if(NOT DEFINED SOURCE OR NOT DEFINED OUTPUT OR NOT DEFINED MODE)
  message(FATAL_ERROR "SOURCE, OUTPUT and MODE are required")
endif()
file(READ "${SOURCE}" content)
if(MODE STREQUAL "export")
  set(old "\"component-provider\"")
  set(new "\"component-provider-invalid\"")
elseif(MODE STREQUAL "contract")
  set(old "SALTS_COMPONENT_PROVIDER_CONTRACT_ID")
  set(new "\"salts.component.provider.wrong.v1\"")
elseif(MODE STREQUAL "binding")
  set(old "SALTS_COMPONENT_PROVIDER_BINDING_ABI_VERSION")
  set(new "SALTS_COMPONENT_PROVIDER_BINDING_ABI_VERSION + UINT32_C(1)")
else()
  message(FATAL_ERROR "Unsupported negative Provider mode: ${MODE}")
endif()
string(FIND "${content}" "${old}" first)
if(first LESS 0)
  message(FATAL_ERROR "Expected single canonical Provider token missing for mode ${MODE}")
endif()
string(LENGTH "${old}" old_length)
math(EXPR tail_start "${first} + ${old_length}")
string(SUBSTRING "${content}" ${tail_start} -1 tail)
string(FIND "${tail}" "${old}" second)
if(NOT second LESS 0)
  message(FATAL_ERROR "Expected exactly one replaceable token for mode ${MODE}")
endif()
string(REPLACE "${old}" "${new}" content "${content}")

# Each loaded DSO needs a unique Plugin identity so duplicate-plugin rejection
# cannot mask the one negative condition under test. The component stable ID
# remains canonical; replace only the second occurrence used as Plugin ID.
set(plugin_id_old "\\"WasmRuntime.Calculator\\"")
if(MODE STREQUAL "export")
  set(plugin_id_new "\\"WasmRuntime.Calculator.NegativeExport\\"")
elseif(MODE STREQUAL "contract")
  set(plugin_id_new "\\"WasmRuntime.Calculator.NegativeContract\\"")
else()
  set(plugin_id_new "\\"WasmRuntime.Calculator.NegativeBinding\\"")
endif()
string(FIND "${content}" "${plugin_id_old}" plugin_first)
if(plugin_first LESS 0)
  message(FATAL_ERROR "Canonical component stable ID not found")
endif()
string(LENGTH "${plugin_id_old}" plugin_id_length)
math(EXPR plugin_tail_start "${plugin_first} + ${plugin_id_length}")
string(SUBSTRING "${content}" ${plugin_tail_start} -1 plugin_tail)
string(FIND "${plugin_tail}" "${plugin_id_old}" plugin_second)
if(plugin_second LESS 0)
  message(FATAL_ERROR "Expected distinct canonical Plugin ID occurrence not found")
endif()
math(EXPR plugin_second_abs "${plugin_tail_start} + ${plugin_second}")
string(SUBSTRING "${content}" 0 ${plugin_second_abs} plugin_prefix)
math(EXPR plugin_after "${plugin_second_abs} + ${plugin_id_length}")
string(SUBSTRING "${content}" ${plugin_after} -1 plugin_suffix)
set(content "${plugin_prefix}${plugin_id_new}${plugin_suffix}")
file(WRITE "${OUTPUT}" "${content}")
