if(NOT DEFINED SOURCE OR NOT DEFINED OUTPUT OR NOT DEFINED MODE)
  message(FATAL_ERROR "SOURCE, OUTPUT and MODE are required")
endif()
file(READ "${SOURCE}" content)
if(MODE STREQUAL "export")
  set(old "\"component-provider\"")
  set(new "\"component-provider-invalid\"")
elseif(MODE STREQUAL "contract")
  set(old "SALTS_COMPONENT_PROVIDER_CONTRACT_ID")
  set(new "\"salts.component.provider.wrong.v1\"")
elseif(MODE STREQUAL "binding")
  set(old "SALTS_COMPONENT_PROVIDER_BINDING_ABI_VERSION")
  set(new "SALTS_COMPONENT_PROVIDER_BINDING_ABI_VERSION + UINT32_C(1)")
else()
  message(FATAL_ERROR "Unsupported negative Provider mode: ${MODE}")
endif()
string(FIND "${content}" "${old}" first)
if(first LESS 0)
  message(FATAL_ERROR "Expected single canonical Provider token missing for mode ${MODE}")
endif()
math(EXPR tail_start "${first} + ${CMAKE_MATCH_COUNT}")
string(SUBSTRING "${content}" ${first} -1 prefix)
string(LENGTH "${old}" old_length)
math(EXPR tail_start "${first} + ${old_length}")
string(SUBSTRING "${content}" ${tail_start} -1 tail)
string(FIND "${tail}" "${old}" second)
if(NOT second LESS 0)
  message(FATAL_ERROR "Expected exactly one replaceable token for mode ${MODE}")
endif()
string(REPLACE "${old}" "${new}" content "${content}")
file(WRITE "${OUTPUT}" "${content}")
