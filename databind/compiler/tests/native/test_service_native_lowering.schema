schema ServiceNative [version(7)];

message AddRequest {
    uint32 left;
    uint32 scale;
}

message AddResponse {
    uint32 sum;
}

message NotFound {
    uint32 id;
}

message PermissionDenied {
    uint32 code;
}

service Calc {
    Add: AddRequest -> AddResponse;
    Find: AddRequest -> AddResponse throws NotFound, PermissionDenied;
}

service A_B {
    C: AddRequest -> AddResponse;
}

service A {
    B_C: AddRequest -> AddResponse;
}
