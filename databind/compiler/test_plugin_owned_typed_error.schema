schema OwnedErrorPlugin [version(1)];

component StorePlugin {
    service Store;
}

message Request {
    uint32 id;
}

message Response {
    uint32 value;
}

message TextError {
    @Size(max = 32) string detail;
}

message BytesError {
    @Size(max = 8) bytes payload;
}

service Store {
    Read: Request -> Response throws TextError, BytesError;
}
