{
  "version": 6,
  "configurePresets": [
    {
      "name": "installed-candidate",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../../build/unicode-installed-consumer",
      "toolchainFile": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/cmake/QigaoVcpkgToolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_MANIFEST_MODE": true,
        "VCPKG_MANIFEST_DIR": "${sourceDir}/../../..",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../../../vcpkg_installed",
        "VCPKG_TARGET_TRIPLET": "$env{QIGAO_TARGET_TRIPLET}",
        "VCPKG_HOST_TRIPLET": "$env{QIGAO_HOST_TRIPLET}",
        "VCPKG_MANIFEST_FEATURES": "capture",
        "CMAKE_FIND_USE_PACKAGE_REGISTRY": false,
        "CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY": false,
        "FLEXUI_UNICODE_INSTALL_PREFIX": "$env{SALTS_ROOT}",
        "FLEXUI_UNICODE_ENABLE_SANITIZERS": true
      },
      "environment": {
        "LD_LIBRARY_PATH": "$env{SALTS_ROOT}/lib:${sourceDir}/../../../vcpkg_installed/$env{QIGAO_TARGET_TRIPLET}/lib:$penv{LD_LIBRARY_PATH}"
      }
    }
  ],
  "buildPresets": [
    { "name": "installed-candidate", "configurePreset": "installed-candidate" }
  ],
  "testPresets": [
    {
      "name": "installed-candidate",
      "configurePreset": "installed-candidate",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 120 }
    }
  ]
}
