@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Rocida 1.1 CONFIG REQUIRED PATHS "${ROCIDA_ROOT_PATH}"
                NO_DEFAULT_PATH)

include("${CMAKE_CURRENT_LIST_DIR}/TurboParserTargets.cmake")

if(TARGET TurboParser::TbeSchema AND NOT TARGET TurboParser::SchemaBE)
  add_library(TurboParser::SchemaBE ALIAS TurboParser::TbeSchema)
endif()

check_required_components(TurboParser)
