@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

if(NOT DEFINED ENV{SALTS_ROOT} OR NOT IS_DIRECTORY "$ENV{SALTS_ROOT}")
  message(FATAL_ERROR "SALTS_ROOT must name the restored Salts SDK")
endif()
file(TO_CMAKE_PATH "$ENV{SALTS_ROOT}" _salts_utils_salts_root)
unset(Salts_DIR CACHE)
unset(Salts_DIR)
# Cache invalidation requires a real lookup, even after another package has
# resolved this same dependency in the current directory.
find_package(Salts CONFIG REQUIRED PATHS "${_salts_utils_salts_root}"
             NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)

# The sole Unicode implementation and target must come from the installed
# Salts SDK. A local SaltsUtils::Unicode/Salts::Unicode export is forbidden.
if(NOT TARGET Salts::Unicode)
  message(FATAL_ERROR "SaltsUtils requires a published Salts SDK exporting Salts::Unicode")
endif()
get_target_property(_salts_utils_unicode_imported Salts::Unicode IMPORTED)
if(NOT _salts_utils_unicode_imported)
  message(FATAL_ERROR "Salts::Unicode must be an imported Salts SDK target")
endif()
unset(_salts_utils_unicode_imported)

# One canonical static ASN1/Crypto SDK, authored by qigao/salts-core.
# A stale qigao/crypto prefix or ambient package is not a fallback.
if(NOT DEFINED ENV{CRYPTO_ROOT} OR "$ENV{CRYPTO_ROOT}" STREQUAL "")
  message(FATAL_ERROR "Installed SaltsUtils requires an exact CRYPTO_ROOT")
endif()
file(TO_CMAKE_PATH "$ENV{CRYPTO_ROOT}" _utils_crypto_root)
foreach(_module IN ITEMS ASN1 Crypto)
  if(NOT EXISTS "${_utils_crypto_root}/lib/cmake/${_module}/${_module}Config.cmake")
    message(FATAL_ERROR "CRYPTO_ROOT missing native ${_module} package")
  endif()
endforeach()
if(DEFINED CMAKE_FIND_ROOT_PATH_MODE_PACKAGE)
  set(_utils_saved_find_root "${CMAKE_FIND_ROOT_PATH_MODE_PACKAGE}")
  set(_utils_had_find_root TRUE)
else()
  set(_utils_had_find_root FALSE)
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE NEVER)
set(ASN1_DIR "${_utils_crypto_root}/lib/cmake/ASN1")
unset(Crypto_DIR CACHE)
unset(Crypto_DIR)
find_dependency(Crypto 0.1 CONFIG PATHS "${_utils_crypto_root}"
  NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
unset(ASN1_DIR)
if(_utils_had_find_root)
  set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE "${_utils_saved_find_root}")
else()
  unset(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE)
endif()
foreach(_target IN ITEMS Salts::ASN1 Salts::Crypto)
  if(NOT TARGET ${_target})
    message(FATAL_ERROR "SaltsUtils missing canonical ${_target}")
  endif()
  get_target_property(_kind ${_target} TYPE)
  get_target_property(_imported ${_target} IMPORTED)
  if(NOT _imported OR NOT _kind STREQUAL "STATIC_LIBRARY")
    message(FATAL_ERROR "${_target} must be imported STATIC")
  endif()
endforeach()
unset(_utils_crypto_root)
unset(_utils_saved_find_root)
unset(_utils_had_find_root)
unset(_target)
unset(_module)
unset(_kind)
unset(_imported)

# Native workflow-only builds do not publish Lua/bindings providers.
# The full legacy Utils package retains its separate explicit binding graph.
if(NOT "@SALTS_UTILS_NATIVE_C11_WORKFLOW_SUBSET@" STREQUAL "ON")
  if(NOT TARGET Lua::Lua)
    add_library(Lua::Lua INTERFACE IMPORTED)
    target_link_libraries(Lua::Lua INTERFACE lua)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/SaltsUtilsTargets.cmake")

set(SaltsUtils_IDLC_HINT "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@")
include("${CMAKE_CURRENT_LIST_DIR}/IDL.cmake")
check_required_components(SaltsUtils)
