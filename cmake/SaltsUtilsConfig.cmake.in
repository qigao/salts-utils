@PACKAGE_INIT@

get_property(_SALTS_UTILS_CONFIG_LOADED GLOBAL
             PROPERTY SALTS_UTILS_CONFIG_LOADED)
if(_SALTS_UTILS_CONFIG_LOADED)
  check_required_components(SaltsUtils)
  return()
endif()

if(NOT DEFINED ENV{SALTS_ROOT} OR "$ENV{SALTS_ROOT}" STREQUAL "")
  message(FATAL_ERROR "SALTS_ROOT must name the installed Salts profile")
endif()
file(TO_CMAKE_PATH "$ENV{SALTS_ROOT}" SALTS_ROOT_PATH)
if(NOT IS_DIRECTORY "${SALTS_ROOT_PATH}")
  message(FATAL_ERROR "SALTS_ROOT is not a directory: $ENV{SALTS_ROOT}")
endif()

include(CMakeFindDependencyMacro)
find_package(OpenSSL CONFIG QUIET)
if(NOT TARGET OpenSSL::Crypto)
  find_dependency(OpenSSL REQUIRED)
endif()
unset(Salts_DIR CACHE)
unset(Salts_DIR)
find_dependency(Salts 1.8.0 EXACT CONFIG REQUIRED PATHS "${SALTS_ROOT_PATH}"
                NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)

foreach(required_salts_target IN ITEMS
        Salts::Platform
        Salts::Core
        Salts::CMeta
        Salts::CFlow
        Salts::CSTL
        Salts::CSerde
        Salts::UriParser
        Salts::PluginABI
        Salts::Plugin)
  if(NOT TARGET ${required_salts_target})
    message(FATAL_ERROR
            "SALTS_ROOT package is missing required target ${required_salts_target}")
  endif()
endforeach()

foreach(pre_migration_target IN ITEMS
        Salts::Crypto
        Salts::CFlowFS
        Salts::CFlowProcess
        Salts::QueryVM
        Salts::IniParser
        Salts::JsonParser
        Salts::JsonCSerdeAdapter
        Salts::XmlParser
        Salts::CsvParser
        Salts::TLVParser
        Salts::LtvParser
        Salts::ModbusParser
        Salts::SoaParser
        Salts::DotEnvParser
        Salts::CmdParser
        Salts::Toon
        Salts::TomlParser
        Salts::DateTimeParser
        Salts::CYaml
        Salts::CYamlJsonAdapter
        Salts::Selector
        Salts::BindingsCpp
        Salts::Lua
        Salts::QuickJS
        Salts::CBind)
  if(TARGET ${pre_migration_target})
    message(FATAL_ERROR
            "SALTS_ROOT points to a pre-migration Salts package that still exports ${pre_migration_target}")
  endif()
endforeach()


if("@SALTS_UTILS_BINDINGS_LUA@" STREQUAL "ON")
  find_dependency(Lua)
  if(NOT TARGET Lua::Lua)
    add_library(Lua::Lua INTERFACE IMPORTED)
    set_target_properties(Lua::Lua PROPERTIES
      INTERFACE_INCLUDE_DIRECTORIES "${LUA_INCLUDE_DIR}"
      INTERFACE_LINK_LIBRARIES "${LUA_LIBRARIES}")
  endif()
endif()

if("@SALTS_UTILS_BINDINGS_QUICKJS@" STREQUAL "ON")
  find_dependency(qjs CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/SaltsUtilsTargets.cmake")

foreach(required_salts_utils_target IN ITEMS
        Salts::IDL
        Salts::Schema
        Salts::DataBindCore
        Salts::DataBind)
  if(NOT TARGET ${required_salts_utils_target})
    message(FATAL_ERROR
            "SaltsUtils 4.1 package is missing required target ${required_salts_utils_target}")
  endif()
endforeach()

if(TARGET Salts::DataBindSchema)
  message(FATAL_ERROR
          "SaltsUtils 4.1 must not export retired Salts::DataBindSchema")
endif()

set(SaltsUtils_DATABINDC_HINT
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@")
include("${CMAKE_CURRENT_LIST_DIR}/DataBind.cmake")

set_property(GLOBAL PROPERTY SALTS_UTILS_CONFIG_LOADED TRUE)
check_required_components(SaltsUtils)
