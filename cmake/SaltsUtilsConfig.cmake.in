@PACKAGE_INIT@

# Older CMake dependency configs can overwrite PACKAGE_PREFIX_DIR.
set(SaltsUtils_IDLC_HINT "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@")
include(CMakeFindDependencyMacro)

# The public SDK is a multi-module package. GmSSL is needed for the static
# Salts::Crypto link closure, NOT to import unrelated Salts::DataBind,
# Salts::Process, Jinja, IDL, or other public targets. A clean installed
# consumer must not depend on the build host's vcpkg GmSSL just to configure.
# Explicit Crypto component consumers still fail fast if that provider is
# unavailable: never fabricate a GmSSL::GmSSL target or silently drop a link.
if("Crypto" IN_LIST SaltsUtils_FIND_COMPONENTS)
  find_dependency(GmSSL CONFIG REQUIRED)
  set(SaltsUtils_Crypto_FOUND TRUE)
endif()

if(NOT DEFINED ENV{SALTS_ROOT} OR NOT IS_DIRECTORY "$ENV{SALTS_ROOT}")
  message(FATAL_ERROR "SALTS_ROOT must name the restored Salts SDK")
endif()
file(TO_CMAKE_PATH "$ENV{SALTS_ROOT}" _salts_utils_salts_root)
unset(Salts_DIR CACHE)
unset(Salts_DIR)
find_dependency(Salts CONFIG REQUIRED PATHS "${_salts_utils_salts_root}"
                NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)

# Jinja and installed consumers require Salts' one canonical Unicode target.
# Never recreate the removed SaltsUtils export or fall back to ICU.
if(NOT TARGET Salts::Unicode)
  message(FATAL_ERROR "SaltsUtils requires a Salts SDK exporting Salts::Unicode")
endif()
get_target_property(_salts_utils_unicode_imported Salts::Unicode IMPORTED)
if(NOT _salts_utils_unicode_imported)
  message(FATAL_ERROR "Salts::Unicode must be imported from the Salts SDK")
endif()
unset(_salts_utils_unicode_imported)

# Runtime packages are selected explicitly by consumers of the VM bindings.
if(NOT TARGET Lua::Lua)
  add_library(Lua::Lua INTERFACE IMPORTED)
  target_link_libraries(Lua::Lua INTERFACE lua)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/SaltsUtilsTargets.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/IDL.cmake")
check_required_components(SaltsUtils)
