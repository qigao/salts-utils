@PACKAGE_INIT@

if(NOT DEFINED ENV{SALTS_ROOT} OR "$ENV{SALTS_ROOT}" STREQUAL "")
  set(SaltsUtils_FOUND FALSE)
  set(SaltsUtils_NOT_FOUND_MESSAGE
      "SALTS_ROOT must name the installed Salts profile")
  return()
endif()
file(TO_CMAKE_PATH "$ENV{SALTS_ROOT}" SALTS_ROOT_PATH)
if(NOT IS_DIRECTORY "${SALTS_ROOT_PATH}")
  set(SaltsUtils_FOUND FALSE)
  set(SaltsUtils_NOT_FOUND_MESSAGE
      "SALTS_ROOT is not a directory: $ENV{SALTS_ROOT}")
  return()
endif()

include(CMakeFindDependencyMacro)
unset(Salts_DIR CACHE)
unset(Salts_DIR)
find_dependency(Salts CONFIG REQUIRED PATHS "${SALTS_ROOT_PATH}"
                NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)

include("${CMAKE_CURRENT_LIST_DIR}/SaltsUtilsTargets.cmake")

if(TARGET Salts::TbeSchema AND NOT TARGET Salts::SchemaBE)
  add_library(Salts::SchemaBE ALIAS Salts::TbeSchema)
endif()

check_required_components(SaltsUtils)
