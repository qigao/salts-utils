@PACKAGE_INIT@

set(_DATABIND_SUPPORTED_COMPONENTS
    Core
    Schema
    Runtime
    CMeta
    JsonAdapter
    YamlAdapter
    CsvAdapter
    XmlAdapter
    TemporalAdapter
    CFlow)

foreach(_DATABIND_COMPONENT IN LISTS DataBind_FIND_COMPONENTS)
  if(NOT _DATABIND_COMPONENT IN_LIST _DATABIND_SUPPORTED_COMPONENTS)
    set(DataBind_${_DATABIND_COMPONENT}_FOUND FALSE)
  endif()
endforeach()

if(NOT DEFINED ENV{SALTS_ROOT} OR "$ENV{SALTS_ROOT}" STREQUAL "")
  set(DataBind_FOUND FALSE)
  set(DataBind_NOT_FOUND_MESSAGE
      "SALTS_ROOT must name the installed Salts profile")
  return()
endif()
file(TO_CMAKE_PATH "$ENV{SALTS_ROOT}" SALTS_ROOT_PATH)
if(NOT IS_DIRECTORY "${SALTS_ROOT_PATH}")
  set(DataBind_FOUND FALSE)
  set(DataBind_NOT_FOUND_MESSAGE
      "SALTS_ROOT is not a directory: $ENV{SALTS_ROOT}")
  return()
endif()

include(CMakeFindDependencyMacro)
unset(Salts_DIR CACHE)
unset(Salts_DIR)
find_dependency(Salts CONFIG REQUIRED
  PATHS "${SALTS_ROOT_PATH}"
  NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)

foreach(_DATABIND_REQUIRED_SALTS_TARGET IN ITEMS
    Salts::Core Salts::CMeta Salts::CSTL Salts::CSerde)
  if(NOT TARGET ${_DATABIND_REQUIRED_SALTS_TARGET})
    set(DataBind_FOUND FALSE)
    set(DataBind_NOT_FOUND_MESSAGE
        "SALTS_ROOT package is missing required target: ${_DATABIND_REQUIRED_SALTS_TARGET}")
    return()
  endif()
endforeach()

# Core/schema/runtime/CMeta are one Salts-only export closure. Importing the
# normal package or requesting only these components must not discover
# SaltsUtils concrete parser targets or CFlow.
if(NOT TARGET DataBind::Core)
  include("${CMAKE_CURRENT_LIST_DIR}/DataBindTargets.cmake")
endif()

set(DataBind_Core_FOUND FALSE)
set(DataBind_Schema_FOUND FALSE)
set(DataBind_Runtime_FOUND FALSE)
set(DataBind_CMeta_FOUND FALSE)
foreach(_DATABIND_BASE_COMPONENT IN ITEMS Core Schema Runtime CMeta)
  if(TARGET DataBind::${_DATABIND_BASE_COMPONENT})
    set(DataBind_${_DATABIND_BASE_COMPONENT}_FOUND TRUE)
  endif()
endforeach()

set(_DATABIND_ADAPTER_COMPONENTS
    JsonAdapter YamlAdapter CsvAdapter XmlAdapter TemporalAdapter)
set(_DATABIND_NEEDS_ADAPTERS FALSE)
foreach(_DATABIND_COMPONENT IN LISTS DataBind_FIND_COMPONENTS)
  if(_DATABIND_COMPONENT IN_LIST _DATABIND_ADAPTER_COMPONENTS)
    set(_DATABIND_NEEDS_ADAPTERS TRUE)
  endif()
endforeach()

foreach(_DATABIND_ADAPTER_COMPONENT IN LISTS _DATABIND_ADAPTER_COMPONENTS)
  set(DataBind_${_DATABIND_ADAPTER_COMPONENT}_FOUND FALSE)
endforeach()

if(_DATABIND_NEEDS_ADAPTERS)
  if(NOT DEFINED ENV{SALTS_UTILS_ROOT} OR "$ENV{SALTS_UTILS_ROOT}" STREQUAL "")
    set(DataBind_FOUND FALSE)
    set(DataBind_NOT_FOUND_MESSAGE
        "SALTS_UTILS_ROOT is required for a requested DataBind concrete adapter component")
    return()
  endif()
  file(TO_CMAKE_PATH "$ENV{SALTS_UTILS_ROOT}" SALTS_UTILS_ROOT_PATH)
  if(NOT IS_DIRECTORY "${SALTS_UTILS_ROOT_PATH}")
    set(DataBind_FOUND FALSE)
    set(DataBind_NOT_FOUND_MESSAGE
        "SALTS_UTILS_ROOT is not a directory: $ENV{SALTS_UTILS_ROOT}")
    return()
  endif()

  unset(SaltsUtils_DIR CACHE)
  unset(SaltsUtils_DIR)
  find_dependency(SaltsUtils CONFIG REQUIRED
    PATHS "${SALTS_UTILS_ROOT_PATH}"
    NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)

  if(NOT TARGET DataBind::JsonAdapter)
    include("${CMAKE_CURRENT_LIST_DIR}/DataBindAdapterTargets.cmake")
  endif()

  foreach(_DATABIND_ADAPTER_COMPONENT IN LISTS _DATABIND_ADAPTER_COMPONENTS)
    if(TARGET DataBind::${_DATABIND_ADAPTER_COMPONENT})
      set(DataBind_${_DATABIND_ADAPTER_COMPONENT}_FOUND TRUE)
    endif()
  endforeach()
endif()

set(DataBind_CFlow_FOUND FALSE)
list(FIND DataBind_FIND_COMPONENTS "CFlow" _DATABIND_CFLOW_COMPONENT_INDEX)
if(NOT _DATABIND_CFLOW_COMPONENT_INDEX EQUAL -1)
  if(NOT TARGET Salts::CFlow)
    set(DataBind_FOUND FALSE)
    set(DataBind_NOT_FOUND_MESSAGE
        "DataBind CFlow component requires Salts::CFlow")
    return()
  endif()
  if(NOT TARGET DataBind::CFlow)
    include("${CMAKE_CURRENT_LIST_DIR}/DataBindCFlowTargets.cmake")
  endif()
  set(DataBind_CFlow_FOUND TRUE)
endif()

foreach(_DATABIND_LEGACY_TARGET IN ITEMS
    Salts::DataBind Salts::DataBindCore Salts::DataBindCMeta
    Salts::DataBindCFlow Salts::TbeSchema Salts::SchemaBE)
  if(TARGET ${_DATABIND_LEGACY_TARGET})
    set(DataBind_FOUND FALSE)
    set(DataBind_NOT_FOUND_MESSAGE
        "Legacy duplicate DataBind ownership is present: ${_DATABIND_LEGACY_TARGET}")
    return()
  endif()
endforeach()

check_required_components(DataBind)

unset(_DATABIND_ADAPTER_COMPONENT)
unset(_DATABIND_ADAPTER_COMPONENTS)
unset(_DATABIND_BASE_COMPONENT)
unset(_DATABIND_CFLOW_COMPONENT_INDEX)
unset(_DATABIND_COMPONENT)
unset(_DATABIND_NEEDS_ADAPTERS)
unset(_DATABIND_REQUIRED_SALTS_TARGET)
unset(_DATABIND_SUPPORTED_COMPONENTS)
