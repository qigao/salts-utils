# Copy to .env and use absolute, forward-slash paths for the current host.
# Praktor's dotenv reader treats values literally: do not use $VAR or ${VAR}.
# These cache settings intentionally match TurboAgent so both repositories use
# one vcpkg-cache checkout and one local binary archive.
VSDEVCMD_BAT=C:/Program Files/Microsoft Visual Studio/2022/BuildTools/Common7/Tools/VsDevCmd.bat
PROJECT_ROOT=C:/projects/cpp
VCPKG_ROOT=C:/tools/vcpkg
VCPKG_CACHE_REPOSITORY_ROOT=C:/Users/your-user/AppData/Local/qigao/vcpkg-cache
VCPKG_BINARY_SOURCES=clear;default,readwrite
CMAKE_BUILD_PARALLEL_LEVEL=2

# Debug and cross-compilation presets require matching installed SDK roots.
# SALTS_ROOT=C:/path/to/salts/debug
# SALTS_HOST_ROOT=C:/path/to/host/salts
# RE2C_ROOT=C:/path/to/re2c/windows-x64

# Required only when restoring published SDK packages. GITHUB_TOKEN must have
# read:packages permission; never commit it to this example or another file.
# GITHUB_TOKEN=
