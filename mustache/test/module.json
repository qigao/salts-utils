{
  "targets": {
    "test_mustache_json": {
      "kind": "executable",
      "sources": {
        "files": [
          "test_json_integration.c"
        ]
      },
      "test": {
        "args": ["--color"],
        "labels": [
          "integration"
        ]
      },
      "when": {
        "native": true
      },
      "private": {
        "includeDirs": [
          "../include",
          "../src"
        ],
        "deps": [
          "mustache",
          "saltsbase_json",
          "saltsbase_tinytest",
          "saltsbase_xml",
          "saltsbase_query",
          "saltsbase_core"
        ]
      },
      "variants": [
        {
          "when": {
            "driver": "msvc"
          },
          "private": {
            "flags": [
              "/experimental:c11atomics"
            ]
          }
        },
        {
          "when": {
            "os": [
              "linux",
              "macos",
              "android"
            ]
          },
          "private": {
            "defines": {
              "_POSIX_C_SOURCE": "200809L"
            }
          }
        }
      ]
    },
