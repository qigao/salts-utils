    "vcpkg_lua": {
      "kind": "prebuilt",
      "public": {
        "requiredIncludeDirs": [
          "$vcpkg/include"
        ]
      },
      "variants": [
        {
          "when": {
            "os": "windows",
            "driver": "llvm-mingw"
          },
          "public": {
            "libs": [
              "$vcpkgConfig/lib/liblua.dll.a"
            ],
            "defines": {
              "LUA_BUILD_AS_DLL": null
            }
          },
          "runtimeBins": [
            "$vcpkgConfig/bin/liblua.dll"
          ]
        },
        {
          "when": {
            "os": "windows",
            "driver": "msvc"
          },
          "public": {
            "libs": [
              "$vcpkgConfig/lib/lua.lib"
            ],
            "defines": {
              "LUA_BUILD_AS_DLL": null
            }
          },
          "runtimeBins": [
            "$vcpkgConfig/bin/lua.dll"
          ]
        },
        {
          "when": {
            "os": [
              "linux",
              "macos",
              "android"
            ]
          },
          "public": {
            "libs": [
              "$vcpkgConfig/lib/liblua.a"
            ],
            "linkFlags": [
