    "saltsbase_core": {
      "kind": "prebuilt",
      "public": {
        "deps": [
          "saltsbase_sdk_headers"
        ],
        "defines": {
          "HAS_ZSTD": "1"
        }
      },
      "variants": [
        {
          "when": {
            "os": "windows",
            "driver": "llvm-mingw"
          },
          "public": {
            "libs": [
              "${envPath:SALTS_BASE_ROOT}/lib/libsalts.dll.a"
            ]
          },
          "runtimeBins": [
            "${envPath:SALTS_BASE_ROOT}/bin/libsalts.dll"
          ]
        },
        {
          "when": {
            "os": "windows",
            "driver": "msvc"
          },
          "public": {
            "libs": [
              "${envPath:SALTS_BASE_ROOT_MSVC}/lib/salts.lib"
            ]
          },
          "runtimeBins": [
            "${envPath:SALTS_BASE_ROOT_MSVC}/bin/salts.dll"
          ]
        },
        {
          "when": {
            "os": [
              "linux",
              "android"
            ]
          },
          "public": {
            "libs": [
              "${envPath:SALTS_BASE_ROOT}/lib/libsalts.so"
            ]
          },
          "runtimeBins": [
            "${envPath:SALTS_BASE_ROOT}/lib/libsalts.so"
          ]
        },
        {
          "when": {
            "os": "macos"
          },
          "public": {
            "libs": [
              "${envPath:SALTS_BASE_ROOT}/lib/libsalts.dylib"
            ]
          },
          "runtimeBins": [
            "${envPath:SALTS_BASE_ROOT}/lib/libsalts.dylib"
          ]
        }
      ]
    },
