{
  "targets": {
    "saltsbase_sdk_headers": {
      "kind": "header_only",
      "variants": [
        {
          "when": {
            "driver": "msvc"
          },
          "public": {
            "requiredIncludeDirs": [
              "${envPath:SALTS_BASE_ROOT_MSVC}/include"
            ]
          }
        },
        {
          "when": {
            "driver": [
              "llvm-mingw",
              "gcc",
              "clang"
            ]
          },
          "public": {
            "requiredIncludeDirs": [
              "${envPath:SALTS_BASE_ROOT}/include"
            ]
          }
        }
      ]
    },
    "cmeta_sdk_headers": {
      "kind": "header_only",
      "variants": [
