#define TBE_LUA_DEFINE_DESCRIPTOR_RECORD(name)                                     \
    DataBindStatus name##_push_lua(struct lua_State *L, const name##_t *object,    \
                                    size_t max_depth) {                             \
        return c11_lua_push_tbe_typed_descriptor(                                  \
            L, name##_typed_descriptor(), object, max_depth);                      \
    }                                                                               \
    DataBindStatus name##_from_lua(struct lua_State *L, int index,                 \
                                    name##_t *object, size_t max_depth,             \
                                    size_t max_dynamic_items) {                     \
        return c11_lua_read_tbe_typed_descriptor(                                  \
            L, index, name##_typed_descriptor(), object, max_depth,                \
            max_dynamic_items);                                                     \
    }

#define TBE_LUA_DEFINE_RAW_RECORD(name)                                            \
    DataBindStatus name##_push_lua(struct lua_State *L, const name##_t *object,    \
                                    size_t max_depth) {                             \
        return c11_lua_push_tbe_typed(L, name##_typed_type(), object, max_depth);  \
    }                                                                               \
    DataBindStatus name##_from_lua(struct lua_State *L, int index,                 \
                                    name##_t *object, size_t max_depth,             \
                                    size_t max_dynamic_items) {                     \
        return c11_lua_read_tbe_typed(L, index, name##_typed_type(), object,       \
                                      max_depth, max_dynamic_items);                \
    }

