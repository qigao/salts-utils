static int {{schema.schema_name}}_lua_{{lua_operation_name}}_await_step(
    struct lua_State *L) {
    {{schema.schema_name}}_lua_{{lua_operation_name}}_future_t *future =
        {{schema.schema_name}}_lua_check_{{lua_operation_name}}_future(L);
    int result_count;

    if (!future->done && !lua_isyieldable(L)) {
        return {{schema.schema_name}}_lua_push_error(
            L, DATA_BIND_ERR_INVALID_ARG, NULL, "await",
            "await requires a yieldable Lua coroutine");
    }
    result_count =
        {{schema.schema_name}}_lua_{{lua_operation_name}}_poll(L);
    if (result_count != 3 || !lua_toboolean(L, 2)) {
        if (result_count != 3) {
            lua_settop(L, 1);
            return {{schema.schema_name}}_lua_push_error(
                L, DATA_BIND_ERR_RUNTIME, NULL, "await",
                "asynchronous poll returned an invalid result");
        }
        lua_settop(L, 1);
        lua_pushvalue(L, 1);
        return lua_yieldk(
            L, 1, (lua_KContext)0,
            {{schema.schema_name}}_lua_{{lua_operation_name}}_await_continue);
    }
    lua_remove(L, 2);
    return 2;
}

