struct {{schema.schema_name}}_lua_async_future_base_s {
    {{schema.schema_name}}_lua_module_state_t *owner;
    {{schema.schema_name}}_lua_async_future_base_t *next;
    void (*cancel_pending)({{schema.schema_name}}_lua_async_future_base_t *base);
};

static void {{schema.schema_name}}_lua_link_pending(
    {{schema.schema_name}}_lua_module_state_t *owner,
    {{schema.schema_name}}_lua_async_future_base_t *base) {
    base->owner = owner;
    base->next = owner->pending_head;
    owner->pending_head = base;
    ++owner->pending_count;
}

static void {{schema.schema_name}}_lua_unlink_pending(
    {{schema.schema_name}}_lua_async_future_base_t *base) {
    {{schema.schema_name}}_lua_async_future_base_t **link;
    if (base == NULL || base->owner == NULL) return;
    link = &base->owner->pending_head;
    while (*link != NULL && *link != base) link = &(*link)->next;
    if (*link == base) {
        *link = base->next;
        if (base->owner->pending_count != 0u) --base->owner->pending_count;
    }
    base->owner = NULL;
    base->next = NULL;
}
{{/has_lua_async_operations}}

static int {{schema.schema_name}}_lua_push_error(
    struct lua_State *L, DataBindStatus status, const DataBindError *error,
    const char *fallback_path, const char *fallback_message) {
    const char *path = fallback_path;
    const char *message = fallback_message;
    size_t path_length = strlen(path != NULL ? path : "");
    size_t message_length = strlen(message != NULL ? message : "operation failed");

    if (error != NULL && error->path[0] != '\0') {
        size_t length = {{schema.schema_name}}_lua_bounded_strlen(
            error->path, sizeof(error->path));
        if (length < sizeof(error->path)) {
            path = error->path;
            path_length = length;
        }
    }
    if (error != NULL && error->message[0] != '\0') {
        size_t length = {{schema.schema_name}}_lua_bounded_strlen(
            error->message, sizeof(error->message));
        if (length < sizeof(error->message)) {
            message = error->message;
            message_length = length;
        }
    }
    lua_pushnil(L);
    lua_createtable(L, 0, 3);
    lua_pushinteger(L, (lua_Integer)status);
    lua_setfield(L, -2, "code");
    lua_pushlstring(L, path != NULL ? path : "", path_length);
    lua_setfield(L, -2, "path");
    lua_pushlstring(L, message != NULL ? message : "operation failed",
                    message_length);
    lua_setfield(L, -2, "message");
    return 2;
}

