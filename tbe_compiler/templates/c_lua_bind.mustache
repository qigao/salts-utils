static int {{schema.schema_name}}_lua_{{lua_operation_name}}_cancel(
    struct lua_State *L) {
    {{schema.schema_name}}_lua_{{lua_operation_name}}_future_t *future =
        {{schema.schema_name}}_lua_check_{{lua_operation_name}}_future(L);
    int changed = !future->done;
    if (changed) {
        {{schema.schema_name}}_lua_{{lua_operation_name}}_cancel_pending(
            &future->base);
        lua_pushnil(L);
        lua_setiuservalue(L, 1, 1);
    }
    lua_pushboolean(L, changed);
    return 1;
}

