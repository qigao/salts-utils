static int {{schema.schema_name}}_lua_call_{{lua_operation_name}}(
    struct lua_State *L) {
    {{schema.schema_name}}_lua_module_state_t *state =
        ({{schema.schema_name}}_lua_module_state_t *)lua_touserdata(
            L, lua_upvalueindex(1));
    {{name}}_t request;
    {{lua_response_type}}_t response;
    DataBindError error = DATA_BIND_ERROR_INIT;
    DataBindStatus status;
    const char *failure_path = "request";
    const char *failure_message = "request does not match the schema";

    if (state == NULL || state->api.{{lua_operation_name}} == NULL) {
        return {{schema.schema_name}}_lua_push_error(
            L, DATA_BIND_ERR_INVALID_ARG, NULL, "operation",
            "Lua operation module state is invalid");
    }
    if (lua_gettop(L) != 1) {
        return {{schema.schema_name}}_lua_push_error(
            L, DATA_BIND_ERR_INVALID_ARG, NULL, "request",
            "operation expects exactly one request table");
    }

    {{name}}_init(&request);
    {{lua_response_type}}_init(&response);
    status = {{name}}_from_lua(L, 1, &request, state->limits.max_depth,
                               state->limits.max_dynamic_items);
    if (status == DATA_BIND_OK) {
        failure_path = "operation";
        failure_message = "operation callback failed";
        status = state->api.{{lua_operation_name}}(
            state->api.context, &request, &response, &error);
    }
    if (status == DATA_BIND_OK) {
        failure_path = "response";
        failure_message = "response cannot be represented in Lua";
        status = {{lua_response_type}}_push_lua(
            L, &response, state->limits.max_depth);
    }

    {{lua_response_type}}_clear(&response);
    {{name}}_clear(&request);
    if (status == DATA_BIND_OK) return 1;
    return {{schema.schema_name}}_lua_push_error(
        L, status, &error, failure_path, failure_message);
}

