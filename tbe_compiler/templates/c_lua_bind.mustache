static int {{schema.schema_name}}_lua_call_{{lua_operation_name}}(
    struct lua_State *L) {
    {{schema.schema_name}}_lua_module_state_t *state =
        ({{schema.schema_name}}_lua_module_state_t *)lua_touserdata(
            L, lua_upvalueindex(1));
    {{schema.schema_name}}_lua_{{lua_operation_name}}_future_t *future;
    DataBindStatus status;
    DataBindError start_error = DATA_BIND_ERROR_INIT;

    if (state == NULL || state->api.{{lua_operation_name}} == NULL) {
        return {{schema.schema_name}}_lua_push_error(
            L, DATA_BIND_ERR_INVALID_ARG, NULL, "operation",
            "Lua asynchronous operation module state is invalid");
    }
    if (lua_gettop(L) != 1) {
        return {{schema.schema_name}}_lua_push_error(
            L, DATA_BIND_ERR_INVALID_ARG, NULL, "request",
            "operation expects exactly one request table");
    }
    if (state->pending_count >= state->limits.max_pending_operations) {
        return {{schema.schema_name}}_lua_push_error(
            L, DATA_BIND_ERR_LIMIT, NULL, "operation",
            "asynchronous operation limit reached");
    }

    future = ({{schema.schema_name}}_lua_{{lua_operation_name}}_future_t *)
        lua_newuserdata(L, sizeof(*future));
    memset(future, 0, sizeof(*future));
    luaL_getmetatable(
        L, "{{schema.schema_name}}.{{lua_operation_name}}.future");
    lua_setmetatable(L, -2);
    lua_pushvalue(L, lua_upvalueindex(1));
    lua_setiuservalue(L, -2, 1);

    future->max_depth = state->limits.max_depth;
    future->status = DATA_BIND_OK;
    future->error = (DataBindError)DATA_BIND_ERROR_INIT;
    {{name}}_init(&future->request);
    {{lua_response_type}}_init(&future->response);
    future->initialized = 1;

    status = {{name}}_from_lua(
        L, 1, &future->request, state->limits.max_depth,
        state->limits.max_dynamic_items);
    if (status != DATA_BIND_OK) {
        {{schema.schema_name}}_lua_{{lua_operation_name}}_clear(future);
        lua_pop(L, 1);
        return {{schema.schema_name}}_lua_push_error(
            L, status, NULL, "request",
            "request does not match the schema");
    }

    future->base.cancel_pending =
        {{schema.schema_name}}_lua_{{lua_operation_name}}_cancel_pending;
    status = state->api.{{lua_operation_name}}(
        state->api.context, &future->request, &future->operation,
        &future->error);
    if (status != DATA_BIND_OK) {
        future->status = status;
        start_error = future->error;
        {{schema.schema_name}}_lua_{{lua_operation_name}}_clear(future);
        lua_pop(L, 1);
        return {{schema.schema_name}}_lua_push_error(
            L, status, &start_error, "operation",
            "asynchronous operation could not be started");
    }
    if (future->operation.poll == NULL || future->operation.destroy == NULL) {
        if (future->operation.destroy != NULL) {
            future->operation.destroy(future->operation.state, 1);
        }
        memset(&future->operation, 0, sizeof(future->operation));
        {{schema.schema_name}}_lua_{{lua_operation_name}}_clear(future);
        lua_pop(L, 1);
        return {{schema.schema_name}}_lua_push_error(
            L, DATA_BIND_ERR_INVALID_ARG, NULL, "operation",
            "asynchronous operation returned invalid hooks");
    }
    {{schema.schema_name}}_lua_link_pending(state, &future->base);
    return 1;
}

