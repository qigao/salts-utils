static void {{schema.schema_name}}_lua_{{lua_operation_name}}_destroy_pending(
    {{schema.schema_name}}_lua_{{lua_operation_name}}_future_t *future,
    int notify_cancel) {
    if (future == NULL || future->base.owner == NULL) return;
    future->operation.destroy(future->operation.state, notify_cancel);
    memset(&future->operation, 0, sizeof(future->operation));
    {{schema.schema_name}}_lua_unlink_pending(&future->base);
}

static void {{schema.schema_name}}_lua_{{lua_operation_name}}_cancel_pending(
    {{schema.schema_name}}_lua_async_future_base_t *base) {
    {{schema.schema_name}}_lua_{{lua_operation_name}}_future_t *future =
        ({{schema.schema_name}}_lua_{{lua_operation_name}}_future_t *)base;
    {{schema.schema_name}}_lua_{{lua_operation_name}}_destroy_pending(future, 1);
    future->status = DATA_BIND_ERR_CANCELED;
    future->done = 1;
}

static void {{schema.schema_name}}_lua_{{lua_operation_name}}_clear(
    {{schema.schema_name}}_lua_{{lua_operation_name}}_future_t *future) {
    if (future == NULL || !future->initialized) return;
    if (future->base.owner != NULL) {
        {{schema.schema_name}}_lua_{{lua_operation_name}}_cancel_pending(
            &future->base);
    }
    {{lua_response_type}}_clear(&future->response);
    {{name}}_clear(&future->request);
    future->initialized = 0;
}

static {{schema.schema_name}}_lua_{{lua_operation_name}}_future_t *
{{schema.schema_name}}_lua_check_{{lua_operation_name}}_future(
    struct lua_State *L) {
