static DataBindStatus {{schema.schema_name}}_lua_client_read_error(
    struct lua_State *L, int index, const char *fallback_path,
    DataBindError *error) {
    int absolute_index = lua_absindex(L, index);
    DataBindStatus status = DATA_BIND_ERR_RUNTIME;
    const char *path = fallback_path;
    const char *message = "Lua import returned no response";
    size_t path_length = strlen(fallback_path != NULL ? fallback_path : "");
    size_t message_length = strlen(message);

    if (lua_istable(L, absolute_index)) {
        lua_pushliteral(L, "code");
        lua_rawget(L, absolute_index);
        if (lua_isinteger(L, -1)) {
            lua_Integer code = lua_tointeger(L, -1);
            if (code > (lua_Integer)DATA_BIND_OK &&
                code <= (lua_Integer)DATA_BIND_ERR_CANCELED) {
                status = (DataBindStatus)code;
            }
        }
        lua_pop(L, 1);

        lua_pushliteral(L, "path");
        lua_rawget(L, absolute_index);
        if (lua_isstring(L, -1)) path = lua_tolstring(L, -1, &path_length);
        lua_pop(L, 1);

        lua_pushliteral(L, "message");
        lua_rawget(L, absolute_index);
        if (lua_isstring(L, -1))
            message = lua_tolstring(L, -1, &message_length);
        lua_pop(L, 1);
    } else if (lua_isstring(L, absolute_index)) {
        message = lua_tolstring(L, absolute_index, &message_length);
    }

    return {{schema.schema_name}}_lua_client_set_error_text(
        error, status, path, path_length, message, message_length);
}

