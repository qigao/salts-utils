static int {{schema.schema_name}}_lua_{{lua_operation_name}}_push_result(
    struct lua_State *L,
    {{schema.schema_name}}_lua_{{lua_operation_name}}_future_t *future) {
    DataBindStatus status;
    lua_pushboolean(L, 1);
    if (future->status != DATA_BIND_OK) {
        return 1 + {{schema.schema_name}}_lua_push_error(
            L, future->status, &future->error, "operation",
            future->status == DATA_BIND_ERR_CANCELED
                ? "asynchronous operation canceled"
                : "asynchronous operation callback failed");
    }
    status = {{lua_response_type}}_push_lua(
        L, &future->response, future->max_depth);
    if (status != DATA_BIND_OK) {
        return 1 + {{schema.schema_name}}_lua_push_error(
            L, status, NULL, "response",
            "asynchronous response cannot be represented in Lua");
    }
    lua_pushnil(L);
    return 3;
}

static int {{schema.schema_name}}_lua_{{lua_operation_name}}_poll(
    struct lua_State *L) {
    {{schema.schema_name}}_lua_{{lua_operation_name}}_future_t *future =
        {{schema.schema_name}}_lua_check_{{lua_operation_name}}_future(L);
    if (!future->done) {
        {
            int out_done = 0;
            future->status = future->operation.poll(
                future->operation.state, &future->response, &out_done,
                &future->error);
            if (future->status != DATA_BIND_OK || out_done) {
                future->done = 1;
                {{schema.schema_name}}_lua_{{lua_operation_name}}_destroy_pending(
                    future, 0);
            }
        }
    }
    if (future->done && future->base.owner == NULL) {
        lua_pushnil(L);
        lua_setiuservalue(L, 1, 1);
    }
    if (!future->done) {
        lua_pushboolean(L, 0);
        lua_pushnil(L);
        lua_pushnil(L);
        return 3;
    }
    return {{schema.schema_name}}_lua_{{lua_operation_name}}_push_result(
        L, future);
}

