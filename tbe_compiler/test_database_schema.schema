schema Accounts [
  id(1),
  version(1),
  byte_order(little),
  db_init(sqlite, "INSERT INTO users (user_id, email, display_name, active, rank) VALUES (500, 'seed@example.com', 'Seed', 1, 4)")
];

[db_table(users)]
message User {
  [db_column(user_id), db_primary_key(1), db_generated(identity)] int64 id;
  [db_unique(1)] string email;
  string display_name;
  bool active default true;
  uint8 rank default 0;
}

[db_table(sessions),
 db_foreign_key(fk_sessions_user, User, user_id, id),
 db_index(idx_sessions_token_user, token, user_id),
 db_unique_index(uidx_sessions_user_token, user_id, token),
 db_check(ck_sessions_token, sqlite, "length(token) >= 4")]
message Session {
  [db_primary_key(1)] uint32 session_id;
  int64 user_id;
  string token;
}

[db_table(integer_limits)]
message IntegerLimits {
  uint64 exact_u64;
  optional uint32 nullable_u32;
}
