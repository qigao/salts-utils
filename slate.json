{
  "include": [
    "slates/Platforms.json",
    "slates/Tools.json"
  ],
  "env": [
    "LLVM_MINGW_ROOT",
    "VSDEVCMD_BAT",
    "ANDROID_NDK_TOOLCHAIN_DIR",
    "VCPKG_INSTALLED_DIR",
    "SALTS_BASE_ROOT",
    "CMETA_ROOT",
    "SLATE_RE2C_ROOT",
    "SLATE_LEMON_ROOT"
  ],
  "defaultPreset": "release",
  "modules": [
    "third_party",
    "vendor",
    "mustache",
    "jinja",
    "databind",
    "bindings"
  ],
  "presets": {
    "base": {
      "cStd": "c11",
      "cxxStd": "c++17",
      "tests": false
    },
    "release": {
      "inherits": "base",
      "config": "release",
      "options": {
        "optimization": "speed"
      },
      "defines": {
        "NDEBUG": null
      }
    },
    "debug": {
      "inherits": "base",
      "config": "debug",
      "options": {
        "optimization": "none",
        "debugInfo": "full"
      },
      "defines": {
        "DEBUG": null
      }
    },
    "tests": {
      "inherits": "release",
      "tests": true
    },
    "debug-tests": {
      "inherits": "debug",
      "tests": true
    },
    "benchmark": {
      "inherits": "release",
      "config": "benchmark",
      "tests": true
    },
    "debug-msvc": {
      "inherits": "debug",
      "targetPlatform": "windows-x64",
      "toolchain": "msvc-win64",
      "vsDevCmd": "${envPath:VSDEVCMD_BAT}"
    },
    "debug-mingw": {
      "inherits": "debug",
      "targetPlatform": "windows-x64",
      "toolchain": "llvm-mingw-x64"
    }
  }
}
