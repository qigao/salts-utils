[
  {
    "name": "callable_value_01",
    "template": "{% set f=range %}{{f(3)|list}}",
    "expected": {
      "status": "ok",
      "output": "[0, 1, 2]"
    }
  },
  {
    "name": "callable_value_02",
    "template": "{% set f=dict %}{{f(a=1)}}|{% set n=namespace %}{% set x=n(a=2) %}{{x.a}}",
    "expected": {
      "status": "ok",
      "output": "{'a': 1}|2"
    }
  },
  {
    "name": "callable_value_03",
    "template": "{% set f=range %}{% set range=none %}{{f(2)|list}}",
    "expected": {
      "status": "ok",
      "output": "[0, 1]"
    }
  },
  {
    "name": "callable_value_04",
    "template": "{{[range][0](3)|join}}|{{{'f':dict}.f(x=1)}}",
    "expected": {
      "status": "ok",
      "output": "012|{'x': 1}"
    }
  },
  {
    "name": "callable_value_05",
    "template": "{% set n=namespace(f=range) %}{{n.f(2)|list}}|{{(n).f(1)|list}}",
    "expected": {
      "status": "ok",
      "output": "[0, 1]|[0]"
    }
  },
  {
    "name": "callable_value_06",
    "template": "{{(range if true else dict)(2)|list}}|{{missing|default(range)(2)|list}}",
    "expected": {
      "status": "ok",
      "output": "[0, 1]|[0, 1]"
    }
  },
  {
    "name": "callable_value_07",
    "template": "{{range==range}}|{{range!=dict}}|{{range is defined}}|{% if range %}Y{% endif %}",
    "expected": {
      "status": "ok",
      "output": "True|True|True|Y"
    }
  },
  {
    "name": "callable_value_08",
    "template": "{% for f in [range,range] %}{{f(loop.index)|join}}{% endfor %}",
    "expected": {
      "status": "ok",
      "output": "001"
    }
  },
  {
    "name": "callable_value_09",
    "template": "{{false and missing()}}|{{true or 1()}}",
    "expected": {
      "status": "ok",
      "output": "False|True"
    }
  },
  {
    "name": "callable_value_10",
    "template": "{% with range=dict %}{{range(x=2)}}{% endwith %}{{range(2)|join}}",
    "expected": {
      "status": "ok",
      "output": "{'x': 2}01"
    }
  },
  {
    "name": "callable_value_11",
    "template": "{% set r=range(4) %}{% set f=r.count %}{% set g=r.index %}{{f(2)}}|{{g(3)}}|{{r['index'](1)}}",
    "expected": {
      "status": "ok",
      "output": "1|3|1"
    }
  },
  {
    "name": "callable_value_12",
    "template": "{% set r=range(3) %}{% set s=range(3) %}{{r.count==r.count}}|{{r.count==s.count}}|{{r.index==r.count}}|{{r[:].count==r.count}}",
    "expected": {
      "status": "ok",
      "output": "True|False|False|False"
    }
  },
  {
    "name": "callable_value_13",
    "template": "{% set r=range(3) %}{% set f=r.count %}{% set r=none %}{{f(1)}}",
    "expected": {
      "status": "ok",
      "output": "1"
    }
  },
  {
    "name": "callable_value_14",
    "template": "{% set n=namespace(count=range,index=dict) %}{{n.count(2)|join}}|{{n.index(x=1)}}",
    "expected": {
      "status": "ok",
      "output": "01|{'x': 1}"
    }
  },
  {
    "name": "callable_value_15",
    "template": "{% set it=[3,range]|reverse %}{{(it|first)(it|first)|join}}|{{it|list}}",
    "expected": {
      "status": "ok",
      "output": "012|[]"
    }
  },
  {
    "name": "callable_value_16",
    "template": "{% set r=range(2) %}{{{r.count:7}[r.count]}}|{{{range:8}[range]}}",
    "expected": {
      "status": "ok",
      "output": "7|8"
    }
  },
  {
    "name": "callable_value_17",
    "template": "{{range is callable}}|{{dict is callable}}|{{namespace is callable}}|{{missing is callable}}|{{none is callable}}|{{1 is callable}}",
    "expected": {
      "status": "ok",
      "output": "True|True|True|True|False|False"
    }
  },
  {
    "name": "callable_value_18",
    "template": "{% set r=range(2) %}{{r.count is callable}}|{{r is callable}}|{{namespace() is callable}}|{% for x in [1] %}{{loop is callable}}{% endfor %}",
    "expected": {
      "status": "ok",
      "output": "True|False|False|True"
    }
  },
  {
    "name": "callable_value_19",
    "template": "{{range|string}}|{{[dict,namespace]}}",
    "expected": {
      "status": "ok",
      "output": "<class 'range'>|[<class 'dict'>, <class 'jinja2.utils.Namespace'>]"
    }
  },
  {
    "name": "callable_value_20",
    "template": "{% autoescape true %}{{dict}}{% endautoescape %}",
    "expected": {
      "status": "ok",
      "output": "&lt;class &#39;dict&#39;&gt;"
    }
  },
  {
    "name": "callable_value_21",
    "template": "{% for f in [range] %}{{dict()}}|{{user.name}}{% endfor %}",
    "context": {
      "user": {
        "name": "Ada"
      }
    },
    "expected": {
      "status": "ok",
      "output": "{}|Ada"
    }
  },
  {
    "name": "callable_value_22",
    "template": "{% for r in [range(2),range(3)] %}{% if not loop.last %}{{loop.nextitem.count(1)}}{% endif %}{% endfor %}",
    "expected": {
      "status": "ok",
      "output": "1"
    }
  }
]
