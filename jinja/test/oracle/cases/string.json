      "type": "TypeError"
    }
  },
  {
    "name": "string_repeat_rejects_float_count",
    "template": "{{ 'a' * 2.0 }}",
    "context": {},
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  },
  {
    "name": "string_filter_expression_composition",
