  {
    "name": "string_membership_precedence_and_chain",
    "template": "{{ 'da' in user.name }}|{{ 'x' not in user.name }}|{{ not 'x' in user.name }}|{{ 'A' in user.name == 'Ada' }}|{{ '\\u00e9' in 'caf\\u00e9' }}|{{ 'A' in user.name and 'yes' }}|{% for item in users %}{% if item.name in user.name %}{{ item.name }}{% endif %}{% endfor %}",
    "context": {
      "user": {
        "name": "Ada"
      },
      "users": [
        {
          "name": "Ada"
        },
        {
          "name": "Lin"
        }
      ]
    },
    "expected": {
      "status": "ok",
      "output": "True|True|True|True|True|yes|Ada"
    }
  },
  {
    "name": "string_literal_truthiness",
    "template": "{% if '' %}bad{% else %}empty{% endif %}:{% if 'x' %}text{% else %}bad{% endif %}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "empty:text"
    }
  },
  {
    "name": "string_addition_and_unicode_slice",
    "template": "{{ user.name + '中😀' }}|{{ ('a' + 'bc')[::-1] }}",
    "context": {
      "user": {
        "name": "Ada"
      }
    },
    "expected": {
      "status": "ok",
      "output": "Ada中😀|cba"
    }
  },
