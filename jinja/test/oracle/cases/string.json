    "template": "{{ 'a' == \"a\" }}|{{ 'a' != 'b' }}|{{ 'a' < 'b' }}|{{ 'a' <= 'a' }}|{{ 'b' > 'a' }}|{{ 'b' >= 'b' }}",
    "context": {},
