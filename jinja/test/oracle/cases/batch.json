[
  {
    "name": "batch_groups_and_fills",
    "template": "{{[1,2,3,4,5]|batch(linecount=2,fill_with=0)|list}}",
    "expected": {
      "status": "ok",
      "output": "[[1, 2], [3, 4], [5, 0]]"
    }
  },
  {
    "name": "batch_unicode",
    "template": "{{'中a🙂'|batch(2)|list}}",
    "expected": {
      "status": "ok",
      "output": "[['中', 'a'], ['🙂']]"
    }
  },
  {
    "name": "batch_zero_negative",
    "template": "{{[1,2]|batch(0)|list}}|{{[1,2]|batch(-1)|list}}",
    "expected": {
      "status": "ok",
      "output": "[[], [1, 2]]|[[1, 2]]"
    }
  },
  {
    "name": "batch_lazy_invalid",
    "template": "{% set g=42|batch(2) %}{{g is iterable}}",
    "expected": {
      "status": "ok",
      "output": "True"
    }
  },
  {
    "name": "batch_lookahead",
    "template": "{% set it={'a':1,'b':2,'c':3,'d':4}|items %}{% set g=it|batch(2) %}{{g|first}}|{{it|list}}|{{g|list}}",
    "expected": {
      "status": "ok",
      "output": "[('a', 1), ('b', 2)]|[('d', 4)]|[[('c', 3)]]"
    }
  },
  {
    "name": "batch_float_linecount",
    "template": "{{[1,2,3]|batch(2.0)|list}}",
    "expected": {
      "status": "ok",
      "output": "[[1, 2], [3]]"
    }
  },
  {
    "name": "batch_nested",
    "template": "{{range(5)|batch(2)|batch(2)|list}}",
    "expected": {
      "status": "ok",
      "output": "[[[0, 1], [2, 3]], [[4]]]"
    }
  },
  {
    "name": "batch_alias",
    "template": "{% set g=range(5)|batch(2) %}{% set h=g %}{{h|first}}|{{g|list}}|{{h|list}}",
    "expected": {
      "status": "ok",
      "output": "[0, 1]|[[2, 3], [4]]|[]"
    }
  },
  {
    "name": "batch_fill_identity",
    "template": "{% set n=namespace(x=1) %}{% set row=[0]|batch(3,n)|first %}{% set n.x=9 %}{{row[1].x}}|{{row[1] == row[2]}}",
    "expected": {
      "status": "ok",
      "output": "9|True"
    }
  },
  {
    "name": "batch_empty_invalid_width",
    "template": "{{[]|batch('x',0)|list}}",
    "expected": {
      "status": "ok",
      "output": "[]"
    }
  },
  {
    "name": "batch_fill_nonpositive_capacity",
    "template": "{% for i in range(100) %}{% set x=[1]|batch(-1,0)|first %}{% endfor %}ok",
    "expected": {
      "status": "ok",
      "output": "ok"
    }
  },
  {
    "name": "batch_loop_neighbors",
    "template": "{% for row in range(5)|batch(2) %}{{loop.index}}:{{row}}:{{loop.previtem|default('-')}}:{{loop.nextitem|default('-')}}:{{loop.last}}:{{loop.length}};{% endfor %}",
    "expected": {
      "status": "ok",
      "output": "1:[0, 1]:-:[2, 3]:False:3;2:[2, 3]:[0, 1]:[4]:False:3;3:[4]:[2, 3]:-:True:3;"
    }
  },
  {
    "name": "batch_loop_alias_after_peek",
    "template": "{% set g=range(5)|batch(2) %}{% for row in g %}{{row}}/{{loop.nextitem}}/{{g|list}};{% endfor %}",
    "expected": {
      "status": "ok",
      "output": "[0, 1]/[2, 3]/[[4]];[2, 3]//[];"
    }
  }
]
