[
  {
    "name": "grouped_condition",
    "template": "{% if (active) %}active{% elif (user.age) %}aged{% else %}empty{% endif %}",
    "context": {
      "active": false,
      "user": {
        "age": 37
      }
    },
    "expected": {
      "status": "ok",
      "output": "aged"
    }
  },
  {
    "name": "grouped_interpolation_path",
    "template": "{{ (user.name) }}|{{ ((user.name)) | safe }}",
    "context": {
      "user": {
        "name": "<Ada>"
      }
    },
    "expected": {
      "status": "ok",
      "output": "<Ada>|<Ada>"
    }
  }
]
