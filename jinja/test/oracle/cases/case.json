[
  {
    "name": "case_upper_expansion",
    "template": "{{'Straße ﬃ'|upper}}",
    "expected": {
      "status": "ok",
      "output": "STRASSE FFI"
    }
  },
  {
    "name": "case_lower_expansion",
    "template": "{{'İ'|lower}}",
    "expected": {
      "status": "ok",
      "output": "i̇"
    }
  },
  {
    "name": "case_lower_final_sigma",
    "template": "{{'ΟΣ ΟΣΑ ΟΣ́'|lower}}",
    "expected": {
      "status": "ok",
      "output": "ος οσα ος́"
    }
  },
  {
    "name": "case_lower_nonfinal_sigma",
    "template": "{{'Σ ΣΑ ΑΣ́Α'|lower}}",
    "expected": {
      "status": "ok",
      "output": "σ σα ασ́α"
    }
  },
  {
    "name": "case_upper_supplementary",
    "template": "{{'𐐨é中文'|upper}}",
    "expected": {
      "status": "ok",
      "output": "𐐀É中文"
    }
  },
  {
    "name": "case_upper_preserves_markup",
    "template": "{% autoescape true %}{{'<b>ß</b>'|safe|upper}}|{{'<b>ß</b>'|upper}}{% endautoescape %}",
    "expected": {
      "status": "ok",
      "output": "<B>SS</B>|&lt;B&gt;SS&lt;/B&gt;"
    }
  },
  {
    "name": "case_lower_string_conversion",
    "template": "{{true|lower}}|{{none|lower}}|{{missing|upper}}|{{['ABC']|lower}}",
    "expected": {
      "status": "ok",
      "output": "true|none||['abc']"
    }
  },
  {
    "name": "case_upper_expanded_empty_arguments",
    "template": "{{'ß'|upper(*[],**{})}}",
    "expected": {
      "status": "ok",
      "output": "SS"
    }
  },
  {
    "name": "case_upper_rejects_arguments",
    "template": "{{'a'|upper(1)}}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  },
  {
    "name": "case_lower_nul",
    "template": "{{'A\\x00B'|lower}}",
    "expected": {
      "status": "ok",
      "output": "a\u0000b"
    }
  }
]
