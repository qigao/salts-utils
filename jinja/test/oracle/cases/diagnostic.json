[
  {
    "name": "diagnostic_location_macro_type_error",
    "template": "{%macro m()%}Y{%endmacro%}{{m() + 1}}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  },
  {
    "name": "diagnostic_location_nested_macro_type_error",
    "template": "{%macro h()%}Z{%endmacro%}{%macro m()%}{{h() + 1}}{%endmacro%}{{m()}}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  },
  {
    "name": "diagnostic_location_eager_second_macro",
    "template": "{%macro a()%}A{%endmacro%}{%macro b()%}B{%endmacro%}{{a()/b()}}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  },
  {
    "name": "diagnostic_location_macro_default",
    "template": "{%macro h()%}Z{%endmacro%}{%macro m(a=h())%}Y{%endmacro%}{{m()+1}}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  },
  {
    "name": "diagnostic_location_unpack_after_macro",
    "template": "{%macro m()%}Y{%endmacro%}{%set a,b=m()%}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "ValueError"
    }
  },
  {
    "name": "diagnostic_location_if_after_macro",
    "template": "{%macro m()%}Y{%endmacro%}{%if m()+1%}X{%endif%}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  },
  {
    "name": "diagnostic_location_for_after_macro",
    "template": "{%macro m()%}Y{%endmacro%}{%for x in m()+1%}X{%endfor%}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  },
  {
    "name": "diagnostic_location_print_after_macro",
    "template": "{%macro m()%}Y{%endmacro%}P{%print m()+1%}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  },
  {
    "name": "diagnostic_location_call_block",
    "template": "{%macro m()%}{{caller() + 1}}{%endmacro%}{%call m()%}Y{%endcall%}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  },
  {
    "name": "diagnostic_location_recursive_loop",
    "template": "{%for x in [0] recursive%}{%if x==0%}{{loop([1])+1}}{%else%}Y{%endif%}{%endfor%}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  },
  {
    "name": "diagnostic_location_signature_after_macro",
    "template": "{%macro m()%}Y{%endmacro%}{{range(m())}}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  },
  {
    "name": "diagnostic_location_filter_end_after_macro",
    "template": "{%macro m()%}Y{%endmacro%}{%filter center(m())%}X{%endfilter%}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  },
  {
    "name": "diagnostic_location_capture_end_after_macro",
    "template": "{%macro m()%}Y{%endmacro%}{%set s|center(m())%}X{%endset%}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  },
  {
    "name": "diagnostic_location_inner_failure",
    "template": "{%macro m()%}{{1/0}}{%endmacro%}{{m()}}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "ZeroDivisionError"
    }
  },
  {
    "name": "diagnostic_location_nested_inner_failure",
    "template": "{%macro h()%}{{1/0}}{%endmacro%}{%macro m()%}{{h()}}{%endmacro%}{{m()}}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "ZeroDivisionError"
    }
  },
  {
    "name": "diagnostic_location_recursive_inner_failure",
    "template": "{%for x in [0] recursive%}{%if x==0%}{{loop([1])}}{%else%}{{1/0}}{%endif%}{%endfor%}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "ZeroDivisionError"
    }
  },
  {
    "name": "diagnostic_location_caller_inner_failure",
    "template": "{%macro m()%}{{caller()}}{%endmacro%}{%call m()%}{{1/0}}{%endcall%}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "ZeroDivisionError"
    }
  },
  {
    "name": "diagnostic_location_unicode_prefix",
    "template": "甲\r\n{%macro m()%}乙{%endmacro%}前{{m()+1}}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  }
]
