[
  {
    "name": "concat_values_precedence_and_unicode",
    "template": "{{ user.name ~ ':' ~ user.age }}|{{ 'x' ~ 2 * 3 }}|{{ true ~ none ~ missing }}|{{ ('中' ~ '😀')[::-1] }}",
    "context": {
      "user": {
        "name": "Ada",
        "age": 37
      }
    },
    "expected": {
      "status": "ok",
      "output": "Ada:37|x6|TrueNone|😀中"
    }
  },
  {
    "name": "concat_repr_and_eager_operand_order",
    "template": "{{ ('v=' ~ ['中', none, missing]) | safe }}|{% for item in [1] %}{{ loop.changed(1) ~ loop.changed(1) ~ loop.changed(2) }}{% endfor %}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "v=['中', None, Undefined]|TrueFalseTrue"
    }
  }
]
