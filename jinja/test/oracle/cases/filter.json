[
  {
    "name": "filter_expand_default",
    "template": "{{missing|default(*['x'],**{'boolean':true})}}",
    "expected": {
      "status": "ok",
      "output": "x"
    }
  },
  {
    "name": "filter_expand_chain",
    "template": "{{' aba '|trim(**{'chars':' '})|replace(*['a','x'],**{'count':1})}}",
    "expected": {
      "status": "ok",
      "output": "xba"
    }
  },
  {
    "name": "filter_expand_sum_join",
    "template": "{{[1,2]|sum(**{'start':3})}}|{{[1,2]|join(*[':'])}}",
    "expected": {
      "status": "ok",
      "output": "6|1:2"
    }
  },
  {
    "name": "filter_expand_empty",
    "template": "{{[1,2]|length(*[],**{})}}|{{'<b>'|escape(*[])}}",
    "expected": {
      "status": "ok",
      "output": "2|&lt;b&gt;"
    }
  },
  {
    "name": "filter_expand_blocks",
    "template": "{% filter replace(*['a','b']) %}a{% endfilter %}|{% set x|trim(**{'chars':' '}) %} a {% endset %}{{x}}",
    "expected": {
      "status": "ok",
      "output": "b|a"
    }
  },
  {
    "name": "filter_separator_in_string_literal",
    "template": "{{ 'a|b' }}|{{ \"c|d\" | safe }}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "a|b|c|d"
    }
  },
  {
    "name": "filter_default_preserves_types_and_boolean_option",
    "template": "{{ missing|default('fallback') }}|{{ 0|default('fallback') }}|{{ 0|default('fallback', true) }}|{{ missing|default([1,2])|length }}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "fallback|0|fallback|2"
    }
  },
  {
    "name": "filter_chain_precedence_inside_arithmetic",
    "template": "{{ 'a' + 'b'|upper }}|{{ ('a' + 'b')|upper }}|{{ ' ABC '|trim|lower }}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "aB|AB|abc"
    }
  },
  {
    "name": "filter_argument_evaluation_is_eager",
    "template": "{% for item in [1] %}{{ 'kept'|default(loop.changed(1)) }}|{{ loop.changed(1) }}{% endfor %}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "kept|False"
    }
  },
  {
    "name": "filter_keyword_default_and_unicode_length",
    "template": "{{ false|default(default_value='yes', boolean=true) }}|{{ 'A中😀é'|length }}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "yes|5"
    }
  },
  {
    "name": "filter_block_nested_in_safe_set_capture",
    "template": "{% autoescape true %}{% set text %}{% filter default('<',true) %}{% endfilter %}{% endset %}{{text}}{% endautoescape %}",
    "expected": {
      "status": "ok",
      "output": "<"
    }
  },
  {
    "name": "filter_block_chain_and_local_scope",
    "template": "{% set x=1 %}{% filter trim|escape %}{% set x=2 %} <{{x}}> {% endfilter %}{{x}}",
    "expected": {
      "status": "ok",
      "output": "&lt;2&gt;1"
    }
  },
  {
    "name": "filter_block_does_not_escape_final_result_again",
    "template": "{% autoescape true %}{% filter default('<',true) %}{% endfilter %}{% endautoescape %}",
    "expected": {
      "status": "ok",
      "output": "<"
    }
  },
  {
    "name": "filter_block_nested_capture",
    "template": "{% filter trim %} A{% filter trim %} B {% endfilter %}C {% endfilter %}",
    "expected": {
      "status": "ok",
      "output": "ABC"
    }
  },
  {
    "name": "filter_block_arguments_see_body_bindings",
    "template": "{% filter default(x,true) %}{% set x='local' %}{% endfilter %}",
    "expected": {
      "status": "ok",
      "output": "local"
    }
  }
]
