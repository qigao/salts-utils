      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  },
  {
    "name": "comparison_test_nan",
    "template": "{{ (1e400-1e400) is eq(0) }}|{{ (1e400-1e400) is ne(0) }}|{{ (1e400-1e400) is ge(0) }}",
    "expected": {
      "status": "ok",
      "output": "False|True|False"
    }
  }
