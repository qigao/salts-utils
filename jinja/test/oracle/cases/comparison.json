  {
    "name": "comparison_test_aliases",
    "template": "{{ 1 is eq(true) }}|{{ 1 is equalto 1.0 }}|{{ 1 is ne('1') }}|{{ 1 is lt(2) }}|{{ 1 is lessthan(2) }}|{{ 2 is le(2) }}|{{ 3 is gt(2) }}|{{ 3 is greaterthan(2) }}|{{ 2 is ge(2) }}",
    "expected": {
      "status": "ok",
      "output": "True|True|True|True|True|True|True|True|True"
    }
  },
  {
    "name": "comparison_test_containers",
    "template": "{{ [1,2] is lt([1,3]) }}|{{ (1,2) is eq((1,2)) }}|{{ [1] is eq((1,)) }}|{{ {'a':1} is eq({'a':true}) }}",
    "expected": {
      "status": "ok",
      "output": "True|True|False|True"
    }
  },
  {
    "name": "comparison_test_keywords_are_rejected",
