[
  {
    "name": "postfix_attribute_after_item_and_group",
    "template": "{{ users[0].name }}|{{ (user).age }}|{{ users[index].name[0] }}|<{{ users[0].missing }}>",
    "context": {
      "user": {
        "age": 37
      },
      "users": [
        {
          "name": "Ada"
        },
        {
          "name": "Lin"
        }
      ],
      "index": 1
    },
    "expected": {
      "status": "ok",
      "output": "Ada|37|L|<>"
    }
  },
  {
    "name": "postfix_attribute_on_undefined_base_is_runtime_error",
    "template": "{{ users[9].name }}",
    "context": {
      "users": [
        {
          "name": "Ada"
        }
      ]
    },
    "expected": {
      "status": "error",
      "category": "undefined",
      "type": "UndefinedError"
    }
  }
]
