[
  {
    "name": "dict_literal_repr_lookup_truth_and_tests",
    "template": "{{ {} | safe }}|{{ {'a': 1, 2: 'b', 'nested': [3]} | safe }}|{{ {'a': 1}['a'] }}|<{{ {'a': 1}['x'] }}>|{% if {} %}bad{% else %}empty{% endif %}|{{ {'a': 1} is mapping }}|{{ {'a': 1} is sequence }}|{{ {'a': 1} is iterable }}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "{}|{'a': 1, 2: 'b', 'nested': [3]}|1|<>|empty|True|True|True"
    }
  },
  {
    "name": "dict_literal_membership_equality_iteration_and_duplicates",
    "template": "{{ 'a' in {'a': 1, 'b': 2} }}|{{ 1 not in {'a': 1} }}|{{ {'a': 1, 'b': 2} == {'b': 2, 'a': 1} }}|{{ {'a': 1} != {'a': 2} }}|{{ {'a': 1, 'a': 2} | safe }}|{{ {'a': 1, 'a': 2}['a'] }}|{% for key in {'a': 1, 'b': 2} %}[{{ key }}]{% endfor %}|{% for key in {} %}bad{% else %}empty{% endfor %}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "True|True|True|True|{'a': 2}|2|[a][b]|empty"
    }
  },
  {
    "name": "dict_literal_dynamic_values",
    "template": "{{ {'name': user.name, user.age: users[1].name}['name'] }}|{{ {'name': user.name, user.age: users[1].name}[37] }}",
    "context": {
      "user": {
        "name": "Ada",
        "age": 37
      },
      "users": [
        {
          "name": "A"
        },
        {
          "name": "Lin"
        }
      ]
    },
    "expected": {
      "status": "ok",
      "output": "Ada|Lin"
    }
  },
  {
    "name": "dict_literal_tuple_key_and_duplicate_iteration",
    "template": "{{ {(1, 2): 'pair'}[(1, 2)] }}|{{ (1, 2) in {(1, 2): 'pair'} }}|{% for key in {'a': 1, 'a': 2, 'b': 3} %}[{{ key }}]{% endfor %}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "pair|True|[a][b]"
    }
  },
  {
    "name": "dict_literal_ordering_is_runtime_error",
    "template": "{{ {'a': 1} < {'b': 2} }}",
    "context": {},
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "TypeError"
    }
  },
  {
    "name": "dict_loop_metadata_uses_unique_length_and_unknown_is_undefined",
    "template": "{% for key in {'a': 1, 'a': 2, 'b': 3} %}{{ loop.index }}/{{ loop.length }}:{{ key }}:<{{ loop.missing }}>{% endfor %}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "1/2:a:<>2/2:b:<>"
    }
  },
  {
    "name": "dict_repr_does_not_repeat_value_calls",
    "template": "{% for item in [1] %}{{ {'a': loop.changed(item)} }}:{{ loop.changed(item) }}{% endfor %}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "{'a': True}:False"
    }
  },
  {
    "name": "dict_closers_can_touch_variable_close",
    "template": "{{ {'x':{'y':2}}}}",
    "expected": {
      "status": "ok",
      "output": "{'x': {'y': 2}}"
    }
  }
]
