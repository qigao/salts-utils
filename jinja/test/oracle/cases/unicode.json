[
  {
    "name": "unicode_normalization_is_not_implicit",
    "template": "{{ 'é' == 'é' }}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "False"
    }
  },
  {
    "name": "unicode_identifier_reference",
    "template": "{{ 用户.名字 }}",
    "context": {
      "用户": {
        "名字": "Ada"
      }
    },
    "expected": {
      "status": "ok",
      "output": "Ada"
    }
  },
  {
    "name": "unicode_whitespace_reference",
    "template": "{{ 1 == 1 }}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "True"
    }
  },
  {
    "name": "unicode_string_escape_above_max_is_syntax",
    "template": "{{ '\\U00110000' }}",
    "context": {},
    "expected": {
      "status": "error",
      "category": "syntax",
      "type": "TemplateSyntaxError"
    }
  },
  {
    "name": "unicode_string_item_lookup_counts_scalars",
    "template": "{{ 'Aé😀'[0] }}|{{ 'Aé😀'[1] }}|{{ 'Aé😀'[-1] }}|{{ text[index] }}|<{{ text[9] }}>",
    "context": {
      "text": "中😀",
      "index": 1
    },
    "expected": {
      "status": "ok",
      "output": "A|é|😀|😀|<>"
    }
  },
  {
    "name": "unicode_slice_uses_scalars_not_bytes_or_graphemes",
    "template": "{{ 'A中😀é'[::-1] }}|{{ 'A中😀é'[1:4:2] }}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "́e😀中A|中e"
    }
  },
  {
    "name": "unicode_string_repeat_integer_counts",
    "template": "{{ '中😀' * 2 }}|{{ 2 * user.name }}|{{ 'a' * -1 }}|{{ '' * 9223372036854775807 }}|{{ ('ab' * true)[::-1] }}",
    "context": {
      "user": {
        "name": "Ada"
      }
    },
    "expected": {
      "status": "ok",
      "output": "中😀中😀|AdaAda|||ba"
    }
  },
  {
    "name": "unicode_repr_latin1_controls",
    "template": "{{ ['\\x80\\x85\\x9f\\xa0\\xad'] }}",
    "expected": {
      "status": "ok",
      "output": "['\\x80\\x85\\x9f\\xa0\\xad']"
    }
  },
  {
    "name": "unicode_repr_bmp_separators",
    "template": "{{ ['\\u1680\\u2000\\u2028\\u2029\\u202f\\u205f\\u3000'] }}",
    "expected": {
      "status": "ok",
      "output": "['\\u1680\\u2000\\u2028\\u2029\\u202f\\u205f\\u3000']"
    }
  },
  {
    "name": "unicode_repr_bmp_format",
    "template": "{{ ['\\u061c\\u200b\\u200c\\u200d\\u202e\\u2060\\ufeff'] }}",
    "expected": {
      "status": "ok",
      "output": "['\\u061c\\u200b\\u200c\\u200d\\u202e\\u2060\\ufeff']"
    }
  },
  {
    "name": "unicode_repr_bmp_unassigned_private",
    "template": "{{ ['\\u0378\\ue000\\uf8ff\\ufffe\\uffff'] }}",
    "expected": {
      "status": "ok",
      "output": "['\\u0378\\ue000\\uf8ff\\ufffe\\uffff']"
    }
  },
  {
    "name": "unicode_repr_astral_nonprintable",
    "template": "{{ ['\\U0001d173\\U000e0001\\U000f0000\\U0010ffff'] }}",
    "expected": {
      "status": "ok",
      "output": "['\\U0001d173\\U000e0001\\U000f0000\\U0010ffff']"
    }
  },
  {
    "name": "unicode_repr_printable_categories",
    "template": "{{ ['中é\\u0301\\u0903\\u20dd٢Ⅳ½—€😀 '] }}",
    "expected": {
      "status": "ok",
      "output": "['中é́ः⃝٢Ⅳ½—€😀 ']"
    }
  },
  {
    "name": "unicode_repr_empty_and_ascii",
    "template": "{{ ['', ' \\t\\n\\r\\x00\\x01\\x1f\\x7f'] }}",
    "expected": {
      "status": "ok",
      "output": "['', ' \\t\\n\\r\\x00\\x01\\x1f\\x7f']"
    }
  },
  {
    "name": "unicode_repr_quote_selection",
    "template": "{{ [\"'\\u200b\", '\"\\u200b', \"'\\\"\\u200b\\\\\"] }}",
    "expected": {
      "status": "ok",
      "output": "[\"'\\u200b\", '\"\\u200b', '\\'\"\\u200b\\\\']"
    }
  },
  {
    "name": "unicode_repr_dict_tuple",
    "template": "{{ {'\\u200b': ('\\xa0', {'\\u2028':'\\U000e0001'})} }}",
    "expected": {
      "status": "ok",
      "output": "{'\\u200b': ('\\xa0', {'\\u2028': '\\U000e0001'})}"
    }
  },
  {
    "name": "unicode_repr_namespace",
    "template": "{{ namespace(x='\\u200b', y='\\xa0') }}",
    "expected": {
      "status": "ok",
      "output": "<Namespace {'x': '\\u200b', 'y': '\\xa0'}>"
    }
  },
  {
    "name": "unicode_repr_string_conversion",
    "template": "{{ ['\\u200b']|string }}|{{ ['\\u200b']|string|length }}",
    "expected": {
      "status": "ok",
      "output": "['\\u200b']|10"
    }
  },
  {
    "name": "unicode_repr_concat",
    "template": "{{ 'a' ~ ['\\u200b'] ~ 'b' }}",
    "expected": {
      "status": "ok",
      "output": "a['\\u200b']b"
    }
  },
  {
    "name": "unicode_repr_join",
    "template": "{{ [['\\u200b'], ('\\xa0',)]|join('|') }}",
    "expected": {
      "status": "ok",
      "output": "['\\u200b']|('\\xa0',)"
    }
  },
  {
    "name": "unicode_repr_ordinary_output",
    "template": "{{ '\\u200b\\xa0\\U000e0001' }}|{{ '\\u200b'|string }}|{{ '\\u200b' ~ '\\xa0' }}",
    "expected": {
      "status": "ok",
      "output": "​ 󠀁|​|​ "
    }
  },
  {
    "name": "unicode_repr_autoescape",
    "template": "{%autoescape true%}{{ ['<\\u200b&'] }}{%endautoescape%}",
    "expected": {
      "status": "ok",
      "output": "[&#39;&lt;\\u200b&amp;&#39;]"
    }
  },
  {
    "name": "unicode_repr_safe_scalar",
    "template": "{{ ['<\\u200b&'|safe] }}",
    "expected": {
      "status": "ok",
      "output": "[Markup('<\\u200b&')]"
    }
  },
  {
    "name": "unicode_repr_safe_container",
    "template": "{%autoescape true%}{{ ['<\\u200b&']|safe }}{%endautoescape%}",
    "expected": {
      "status": "ok",
      "output": "['<\\u200b&']"
    }
  },
  {
    "name": "unicode_repr_capture",
    "template": "{%set x%}{{ ['\\u200b'] }}{%endset%}{{ x }}|{{ x|length }}",
    "expected": {
      "status": "ok",
      "output": "['\\u200b']|10"
    }
  },
  {
    "name": "unicode_repr_macro",
    "template": "{%macro m(x)%}{{ [x] }}{%endmacro%}{{m('\\u200b')}}",
    "expected": {
      "status": "ok",
      "output": "['\\u200b']"
    }
  },
  {
    "name": "unicode_repr_caller",
    "template": "{%macro m()%}{{ [caller()] }}{%endmacro%}{%call m()%}{{ '\\u200b' }}{%endcall%}",
    "expected": {
      "status": "ok",
      "output": "['\\u200b']"
    }
  },
  {
    "name": "unicode_repr_filtered_loop_reentry",
    "template": "{%macro p(i)%}{{ ['\\u200b']|string }}{%endmacro%}{%for i in [1,2] if p(i)%}{{ [loop, '\\xa0']|string }};{%endfor%}",
    "expected": {
      "status": "ok",
      "output": "[<LoopContext 1/2>, '\\xa0'];[<LoopContext 2/2>, '\\xa0'];"
    }
  },
  {
    "name": "unicode_repr_scalar_slices",
    "template": "{%set x='A\\u200bB\\xa0C'%}{{ [x[1],x[1:4],x[::-1]] }}",
    "expected": {
      "status": "ok",
      "output": "['\\u200b', '\\u200bB\\xa0', 'C\\xa0B\\u200bA']"
    }
  },
  {
    "name": "unicode_repr_cycle_marker",
    "template": "{%set n=namespace(x=none)%}{%set n.x=['\\u200b',n]%}{{ n }}",
    "expected": {
      "status": "ok",
      "output": "<Namespace {'x': ['\\u200b', <Namespace {...}>]}>"
    }
  },
  {
    "name": "unicode_repr_host_string",
    "template": "{{ [value] }}|{{ value }}",
    "context": {
      "value": "a​ "
    },
    "expected": {
      "status": "ok",
      "output": "['a\\u200b\\xa0']|a​ "
    }
  }
]
