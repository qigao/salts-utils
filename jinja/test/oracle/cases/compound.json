[
  {
    "name": "compound_slice_missing",
    "template": "{{ [1,2][:,1] is undefined }}|{{ 'abc'[::2,1:3]|default('missing') }}",
    "expected": {
      "status": "ok",
      "output": "True|missing"
    }
  },
  {
    "name": "compound_slice_not_tuple",
    "template": "{{ {((none,none,none),1):'wrong'}[:,1]|default('missing') }}",
    "expected": {
      "status": "ok",
      "output": "missing"
    }
  },
  {
    "name": "compound_slice_arbitrary_bounds",
    "template": "{{ {1:'x'}[[]:{'x':1}:0,1] is undefined }}",
    "expected": {
      "status": "ok",
      "output": "True"
    }
  },
  {
    "name": "compound_slice_order",
    "template": "{% set g={'a':1,'b':2,'c':3,'d':4}|items %}{{ [1][(g|first):(g|first):(g|first),g|first] is undefined }}|{{g|list}}",
    "expected": {
      "status": "error",
      "category": "syntax",
      "type": "SyntaxError"
    }
  },
  {
    "name": "compound_slice_short_circuit",
    "template": "{{ false and [1][missing.x:,0] }}",
    "expected": {
      "status": "ok",
      "output": "False"
    }
  }
]
