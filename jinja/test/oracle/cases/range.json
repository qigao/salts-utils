  {
    "name": "range_one_two_three_arguments_and_negative_step",
    "template": "{% for i in range(4) %}{{ i }}{% endfor %}|{% for i in range(2,5) %}{{ i }}{% endfor %}|{% for i in range(5,-1,-2) %}{{ i }}{% endfor %}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "0123|234|531"
    }
  },
  {
    "name": "range_empty_direction_and_boolean_arguments",
    "template": "{% for i in range(3,0) %}X{% else %}empty{% endfor %}|{% for i in range(0,3,-1) %}X{% else %}empty{% endfor %}|{% for i in range(true) %}{{ i }}{% endfor %}",
    "context": {},
    "expected": {
      "status": "ok",
      "output": "empty|empty|0"
    }
  },
  {
    "name": "range_repr_is_distinct_from_list_repr",
