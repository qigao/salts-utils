  {
    "name": "raw_end_can_overlap_an_opening_brace",
    "template": "{% raw %}{{% endraw %}",
    "expected": {
      "status": "ok",
      "output": "{"
    }
  },
  {
    "name": "raw_markers_accept_unicode_whitespace_and_plus",
    "template": "{%+　raw %}x{%+　endraw +%}",
    "expected": {
      "status": "ok",
      "output": "x"
    }
  },
  {
    "name": "raw_minus_trims_unicode_whitespace",
    "template": "A　{%-raw-%} x　{%-endraw-%} B",
    "expected": {
      "status": "ok",
      "output": "AxB"
    }
  },
  {
    "name": "raw_keeps_text_before_a_later_trimmed_interpolation",
    "template": "A {% raw %}x {% endraw %}{{- value }}",
    "context": {
      "value": "Ada"
    },
    "expected": {
      "status": "ok",
      "output": "A x Ada"
    }
