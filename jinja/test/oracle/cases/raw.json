  {
    "name": "raw_ignores_inner_tags_and_unclosed_comments",
    "template": "A{% raw %}{{ missing }}{% if broken {# unterminated{% endraw %}B",
    "expected": {
      "status": "ok",
      "output": "A{{ missing }}{% if broken {# unterminatedB"
    }
