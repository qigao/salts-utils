[
  {
    "name": "markup_default_autoescape_is_disabled",
    "template": "{{ value }}",
    "context": {
      "value": "<b>"
    },
    "expected": {
      "status": "ok",
      "output": "<b>"
    }
  },
  {
    "name": "markup_escape_uses_numeric_quote_entities",
    "template": "{{ value|escape }}",
    "context": {
      "value": "\"'"
    },
    "expected": {
      "status": "ok",
      "output": "&#34;&#39;"
    }
  },
  {
    "name": "markup_safe_then_escape_preserves_safety",
    "template": "{{ value|safe|escape }}",
    "context": {
      "value": "<b>"
    },
    "expected": {
      "status": "ok",
      "output": "<b>"
    }
  },
  {
    "name": "markup_autoescape_block_restores_outer_policy",
    "template": "{% autoescape true %}{{ value }}|{{ value|safe }}{% endautoescape %}|{{ value }}",
    "context": {
      "value": "<b>"
    },
    "expected": {
      "status": "ok",
      "output": "&lt;b&gt;|<b>|<b>"
    }
  },
  {
    "name": "markup_addition_escapes_unsafe_operand",
    "template": "{{ (value|safe) + other }}",
    "context": {
      "value": "<b>",
      "other": "<i>"
    },
    "expected": {
      "status": "ok",
      "output": "<b>&lt;i&gt;"
    }
  },
  {
    "name": "markup_forceescape_reescapes_safe_and_escaped_values",
    "template": "{{ value|safe|escape }}|{{ value|safe|forceescape }}|{{ value|escape|forceescape }}",
    "context": {
      "value": "<b>"
    },
    "expected": {
      "status": "ok",
      "output": "<b>|&lt;b&gt;|&amp;lt;b&amp;gt;"
    }
  },
  {
    "name": "markup_slice_and_repeat_preserve_safety",
    "template": "{{ ((value|safe)[1:4]) is escaped }}|{{ ((value|safe)*2) is escaped }}",
    "context": {
      "value": "<b>"
    },
    "expected": {
      "status": "ok",
      "output": "True|True"
    }
  },
  {
    "name": "markup_trim_and_center_preserve_safety",
    "template": "{{ (value|safe|trim) is escaped }}|{{ (value|safe|center(8)) is escaped }}",
    "context": {
      "value": "<b>"
    },
    "expected": {
      "status": "ok",
      "output": "True|True"
    }
  },
  {
    "name": "markup_list_characters_lose_safety",
    "template": "{{ (value|safe|list|first) is escaped }}",
    "context": {
      "value": "<b>"
    },
    "expected": {
      "status": "ok",
      "output": "False"
    }
  },
  {
    "name": "markup_concat_without_autoescape_uses_plain_strings",
    "template": "{{ (value|safe) ~ other }}|{{ other ~ (value|safe) }}",
    "context": {
      "value": "<b>",
      "other": "<i>"
    },
    "expected": {
      "status": "ok",
      "output": "<b><i>|<i><b>"
    }
  },
  {
    "name": "markup_concat_with_autoescape_escapes_unsafe_parts",
    "template": "{% autoescape true %}{{ (value|safe) ~ other }}|{{ other ~ (value|safe) }}{% endautoescape %}",
    "context": {
      "value": "<b>",
      "other": "<i>"
    },
    "expected": {
      "status": "ok",
      "output": "<b>&lt;i&gt;|&lt;i&gt;<b>"
    }
  },
  {
    "name": "markup_right_addition_escapes_left_plain_string",
    "template": "{{ other + (value|safe) }}",
    "context": {
      "value": "<b>",
      "other": "<i>"
    },
    "expected": {
      "status": "ok",
      "output": "&lt;i&gt;<b>"
    }
  },
  {
    "name": "markup_escape_is_idempotent_and_marks_output_safe",
    "template": "{{ value|escape|escape }}|{{ (value|escape) is escaped }}",
    "context": {
      "value": "<b>"
    },
    "expected": {
      "status": "ok",
      "output": "&lt;b&gt;|True"
    }
  },
  {
    "name": "markup_container_repr_keeps_type_information",
    "template": "{{ [value|safe] }}|{{ (value|safe,) }}|{{ {'x':value|safe}|string }}",
    "context": {
      "value": "<b>"
    },
    "expected": {
      "status": "ok",
      "output": "[Markup('<b>')]|(Markup('<b>'),)|{'x': Markup('<b>')}"
    }
  },
  {
    "name": "markup_first_and_last_use_distinct_string_protocols",
    "template": "{{ ((value|safe)[0]) is escaped }}|{{ (value|safe|first) is escaped }}|{{ (value|safe|last) is escaped }}|{{ (value|safe|list|first) is escaped }}",
    "context": {
      "value": "<b>"
    },
    "expected": {
      "status": "ok",
      "output": "True|False|True|False"
    }
  }
]
