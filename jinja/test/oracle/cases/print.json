[
  {
    "name": "print_empty",
    "template": "A{% print %}B",
    "expected": {
      "status": "ok",
      "output": "AB"
    }
  },
  {
    "name": "print_list_and_parenthesized_tuple",
    "template": "{% print 1,2 %}|{% print (1,2) %}",
    "expected": {
      "status": "ok",
      "output": "12|(1, 2)"
    }
  },
  {
    "name": "print_keyword_boundary",
    "template": "{% print(1) %}|{% print[1,2] %}",
    "expected": {
      "status": "ok",
      "output": "1|[1, 2]"
    }
  },
  {
    "name": "print_nested_commas_and_conditional",
    "template": "{% print 'a,b', (1,), (), 3 if false else 4 %}",
    "expected": {
      "status": "ok",
      "output": "a,b(1,)()4"
    }
  },
  {
    "name": "print_per_expression_safety",
    "template": "{% autoescape true %}{% print '<'|safe, '>' %}{% endautoescape %}|{% print '<>' %}",
    "expected": {
      "status": "ok",
      "output": "<&gt;|<>"
    }
  },
  {
    "name": "print_ordered_side_effects",
    "template": "{% for x in [1,2] %}{% print loop.changed(x),loop.changed(x) %}{% endfor %}",
    "expected": {
      "status": "ok",
      "output": "TrueFalseTrueFalse"
    }
  },
  {
    "name": "print_rejects_trailing_comma",
    "template": "{% print 1, %}",
    "expected": {
      "status": "error",
      "category": "syntax",
      "type": "TemplateSyntaxError"
    }
  },
  {
    "name": "print_propagates_later_expression_error",
    "template": "ab{% print 1,1/0 %}",
    "expected": {
      "status": "error",
      "category": "runtime",
      "type": "ZeroDivisionError"
    }
  }
]
