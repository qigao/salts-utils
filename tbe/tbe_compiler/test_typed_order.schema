schema Orders [id(42), version(1), byte_order(little)];

enum Side <uint8> {
    Buy = 1;
    Sell = 2;
}

enum WideCode <uint64> {
    Max = 18446744073709551615;
}

composite Header {
    uint32 seq;
}

group Fill {
    int32 price;
    uint32 qty;
}

[lua_operation(create_order), lua_response(OrderResult)]
message Order {
    Header header;
    [name(orderId), alias(oldId), alias(legacyId), c(order_id)] 
    uint32 id;
    int64 min_value;
    uint64 max_value;
    uuid request_id;
    Side side;
    optional uint32 routing_hint;
    group<Fill> fills;
    string symbol;
    optional string client_tag;
    bytes payload;
}

[lua_operation(fetch_order), lua_response(OrderResult), lua_async(future)]
message AsyncOrder {
    uint32 id;
    string symbol;
}

message LuaOrder {
    uint32 id;
    string symbol;
}

message AsyncLuaOrder {
    uint32 id;
    string symbol;
}

message OrderResult {
    uint32 id;
    string symbol;
}
