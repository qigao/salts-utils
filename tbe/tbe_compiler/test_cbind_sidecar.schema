schema CBindSidecar [id(73), version(1), byte_order(little)];

enum CBindDefaultState {
    Idle = 0;
    Active = 3;
}

enum CBindState <uint16> {
    Unknown = 0;
    Ready = 7;
    Done = 9;
    cbind_read = 10;
    cbind_descriptor = 11;
}

composite CBindHeader {
    int32 sequence;
}

message CBindEnvelope {
    CBindHeader header;
    [name(eventId), c(event_id)] int32 id;
    bool enabled;
    int8 sint8;
    uint8 uint8_value;
    int16 sint16;
    uint16 uint16_value;
    int32 sint32;
    uint32 uint32_value;
    int64 sint64;
    uint64 uint64_value;
    float real32;
    double real64;
    string note;
    uuid request_id;
    CBindState state;
    CBindDefaultState default_state;
}
