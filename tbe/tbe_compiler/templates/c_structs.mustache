/**
 * @brief Tagged union {{name}}
 *
 * Wire layout: [tag:1][variant_data:N]
 * The tag byte identifies which variant is active.
 */
typedef enum {
{{#fields}}
    {{owner_name}}_tag_{{name}} = {{field_index}},
{{/fields}}
    {{name}}_tag_COUNT
} {{name}}_tag_t;

/**
 * @brief Get the active tag from a {{name}} buffer
 */
static inline {{name}}_tag_t {{name}}_get_tag(const uint8_t *buf, size_t size) {
    if (!buf || size < 1) return {{name}}_tag_COUNT;
    return ({{name}}_tag_t)buf[0];
}

/**
 * @brief Set the tag in a mutable {{name}} buffer
 */
static inline void {{name}}_set_tag(uint8_t *buf, size_t size, {{name}}_tag_t tag) {
    if (buf && size >= 1) buf[0] = (uint8_t)tag;
}

/**
 * @brief Get a const pointer to the variant payload (bytes after the tag)
 */
static inline const uint8_t *{{name}}_payload(const uint8_t *buf, size_t size, size_t *payload_size) {
    if (!buf || size < 1) return NULL;
    if (payload_size) *payload_size = size - 1;
    return buf + 1;
}

/**
 * @brief Get a mutable pointer to the variant payload
 */
static inline uint8_t *{{name}}_payload_mut(uint8_t *buf, size_t size, size_t *payload_size) {
    if (!buf || size < 1) return NULL;
    if (payload_size) *payload_size = size - 1;
    return buf + 1;
}

