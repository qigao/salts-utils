/**
 * @brief Convert trusted-host text formats to wire views and back.
 *
 * From-functions write schema wire bytes into wire_output, set out_size, and
 * bind out_view on success. To-functions serialize an existing view into the
 * caller-provided text_output and set out_size. CSV input additionally selects
 * a zero-based logical record. All sizes are checked against the uint32 Wasm
 * ABI. Local validation failures return tbe_guest_status_t; bridge/provider
 * failures are returned unchanged.
 */
#define TBE_GUEST_DECLARE_RECORD(record) \
    int32_t record##_guest_from_json(const tbe_guest_bridge_t *bridge, const void *input, size_t input_len, uint8_t *wire_output, size_t wire_capacity, size_t *out_size, record##_view_t *out_view); \
    int32_t record##_guest_from_yaml(const tbe_guest_bridge_t *bridge, const void *input, size_t input_len, uint8_t *wire_output, size_t wire_capacity, size_t *out_size, record##_view_t *out_view); \
    int32_t record##_guest_from_csv(const tbe_guest_bridge_t *bridge, const void *input, size_t input_len, size_t csv_row, uint8_t *wire_output, size_t wire_capacity, size_t *out_size, record##_view_t *out_view); \
    int32_t record##_guest_from_xml(const tbe_guest_bridge_t *bridge, const void *input, size_t input_len, uint8_t *wire_output, size_t wire_capacity, size_t *out_size, record##_view_t *out_view); \
    int32_t record##_guest_to_json(const tbe_guest_bridge_t *bridge, const record##_view_t *view, char *text_output, size_t text_capacity, size_t *out_size); \
    int32_t record##_guest_to_yaml(const tbe_guest_bridge_t *bridge, const record##_view_t *view, char *text_output, size_t text_capacity, size_t *out_size); \
    int32_t record##_guest_to_csv(const tbe_guest_bridge_t *bridge, const record##_view_t *view, char *text_output, size_t text_capacity, size_t *out_size); \
    int32_t record##_guest_to_xml(const tbe_guest_bridge_t *bridge, const record##_view_t *view, char *text_output, size_t text_capacity, size_t *out_size)

{{#composites}}{{#has_fixed_block_size}}TBE_GUEST_DECLARE_RECORD({{name}});
