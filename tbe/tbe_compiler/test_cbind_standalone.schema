schema CBindStandalone [id(74), version(1), byte_order(little)];

enum CBindStandaloneState <uint8> {
    Idle = 0;
    Ready = 1;
}

composite CBindStandaloneDetails {
    int32 sequence;
    uuid nested_request_id;
}

message CBindStandaloneEnvelope {
    CBindStandaloneDetails details;
    [name(eventId), c(event_id)] int32 id;
    bool enabled;
    int64 min_value;
    uint64 max_value;
    string label;
    uuid request_id;
    CBindStandaloneState state;
}
