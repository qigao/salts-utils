{
    "version": 6,
    "include": [
        "CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "vcpkg-cache",
            "hidden": true,
            "toolchainFile": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/cmake/QigaoVcpkgToolchain.cmake",
            "environment": {
                "VCPKG_BINARY_SOURCES": "clear;default,readwrite;nugettimeout,1800;nugetconfig,${sourceDir}/cmake/vcpkg-cache.nuget.config,read",
                "VCPKG_OVERLAY_PORTS": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/ports",
                "RE2C_ROOT": "$penv{RE2C_ROOT}",
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}$penv{PATH}"
            }
        },
        {
            "name": "vcpkg-cache-windows",
            "hidden": true,
            "inherits": "vcpkg-cache",
            "cacheVariables": {
                "VCPKG_HOST_TRIPLET": "x64-windows"
            },
            "environment": {
                "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{LOCALAPPDATA}/qigao/vcpkg-cache",
                "RE2C_ROOT": "$env{PKG_ROOT}/re2c/windows-x64"
            }
        },
        {
            "name": "vcpkg-cache-linux",
            "hidden": true,
            "inherits": "vcpkg-cache",
            "cacheVariables": {
                "VCPKG_HOST_TRIPLET": "x64-linux"
            },
            "environment": {
                "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{HOME}/.cache/qigao/vcpkg-cache"
            }
        },
        {
            "name": "vcpkg-cache-ci",
            "hidden": true,
            "inherits": "vcpkg-cache",
            "cacheVariables": {
                "CMAKE_C_COMPILER_LAUNCHER": "sccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "sccache"
            },
            "environment": {
                "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{VCPKG_CACHE_REPOSITORY_ROOT}",
                "VCPKG_BINARY_SOURCES": "$penv{VCPKG_BINARY_SOURCES}",
                "VCPKG_OVERLAY_PORTS": "$penv{VCPKG_OVERLAY_PORTS}",
                "SCCACHE_C_CUSTOM_CACHE_BUSTER": "salts-utils-compile-v2-${presetName}-$env{QIGAO_SDK_RID}-$env{QIGAO_TARGET_TRIPLET}"
            }
        },
        {
            "name": "ci-native-paths",
            "hidden": true,
            "inherits": [
                "vcpkg-cache-ci",
                "pkg-vcpkg"
            ],
            "generator": "Ninja",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "VCPKG_TARGET_TRIPLET": "$env{QIGAO_TARGET_TRIPLET}",
                "VCPKG_HOST_TRIPLET": "$env{QIGAO_TARGET_TRIPLET}"
            },
            "environment": {
                "PKG_ROOT": "${sourceDir}/stage",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
                "SALTS_UTILS_CI_BUILD_ROOT": "${sourceDir}/build/ci-sdk/$env{QIGAO_SDK_RID}"
            }
        },
        {
            "name": "ci-sdk-release-user",
            "inherits": [
                "ci-native-paths",
                "release-mode"
            ],
            "binaryDir": "$env{SALTS_UTILS_CI_BUILD_ROOT}",
            "description": "Release SDK packaging retains the existing stage/sdk/<RID> installation contract.",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/sdk/$env{QIGAO_SDK_RID}",
                "SALTS_UTILS_ENABLE_CAPTURE": false,
                "BUILD_TESTS": false,
                "BUILD_BENCHMARKS": false,
                "BUILD_EXAMPLES": false,
                "ENABLE_SANITIZER_ADDRESS": false,
                "ENABLE_SANITIZER_UNDEFINED": false
            },
            "environment": {
                "SALTS_ROOT": "$penv{SALTS_ROOT}",
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}$env{SALTS_UTILS_CI_BUILD_ROOT}/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$penv{PATH}",
                "LD_LIBRARY_PATH": "$env{SALTS_UTILS_CI_BUILD_ROOT}/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
                "DYLD_LIBRARY_PATH": "$env{SALTS_UTILS_CI_BUILD_ROOT}/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$penv{DYLD_LIBRARY_PATH}"
            }
        },
        {
            "name": "ci-sdk-capture-release-user",
            "inherits": "ci-sdk-release-user",
            "cacheVariables": {
                "SALTS_UTILS_ENABLE_CAPTURE": true,
                "VCPKG_MANIFEST_FEATURES": "capture"
            }
        },
        {
            "name": "ci-win-sdk-release-user",
            "inherits": [
                "ci-sdk-capture-release-user",
                "base-win-release-user"
            ],
            "environment": {
                "VCPKG_ROOT": "$penv{QIGAO_VCPKG_ROOT}"
            }
        },
        {
            "name": "ci-win-release-user",
            "inherits": [
                "ci-native-release-user",
                "base-win-release-user"
            ],
            "binaryDir": "${sourceDir}/build/ci-win-release",
            "cacheVariables": {
                "BUILD_TESTS": true
            },
            "environment": {
                "VCPKG_ROOT": "$penv{QIGAO_VCPKG_ROOT}",
                "SALTS_UTILS_CI_BUILD_ROOT": "${sourceDir}/build/ci-win-release"
            }
        },
        {
            "name": "ci-win-dev-user",
            "inherits": [
                "ci-native-paths",
                "base-win-dev-user"
            ],
            "binaryDir": "${sourceDir}/build/ci-win-dev",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/debug",
                "BUILD_TESTS": true,
                "BUILD_BENCHMARKS": false,
                "BUILD_EXAMPLES": false,
                "SALTS_UTILS_ENABLE_CAPTURE": false,
                "ENABLE_SANITIZER_ADDRESS": true
            },
            "environment": {
                "VCPKG_ROOT": "$penv{QIGAO_VCPKG_ROOT}",
                "SALTS_ROOT": "$penv{SALTS_ROOT}",
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/ci-win-dev/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$penv{PATH}"
            }
        },
        {
            "name": "ci-host-release-user",
            "inherits": "ci-sdk-release-user",
            "binaryDir": "${sourceDir}/build/ci-host",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils-host/release"
            },
            "environment": {
                "QIGAO_TARGET_TRIPLET": "$env{QIGAO_HOST_TRIPLET}",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed-host",
                "SALTS_ROOT": "$penv{SALTS_HOST_ROOT}",
                "SALTS_UTILS_CI_BUILD_ROOT": "${sourceDir}/build/ci-host",
                "X_VCPKG_NUGET_ID_PREFIX": ""
            }
        },
        {
            "name": "ci-android-sdk-release-user",
            "inherits": "ci-sdk-capture-release-user",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Android",
                "VCPKG_HOST_TRIPLET": "$env{QIGAO_HOST_TRIPLET}",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-26",
                "ANDROID_STL": "c++_shared",
                "SALTS_UTILS_HOST_LEMON_EXECUTABLE": "${sourceDir}/build/ci-host/bin/lemon"
            },
            "environment": {
                "ANDROID_NDK_HOME": "$penv{ANDROID_NDK_HOME}"
            }
        },
        {
            "name": "ci-ios-sdk-release-user",
            "inherits": "ci-sdk-capture-release-user",
            "cacheVariables": {
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-ports",
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_OSX_SYSROOT": "$env{QIGAO_IOS_SYSROOT}",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "VCPKG_HOST_TRIPLET": "$env{QIGAO_HOST_TRIPLET}",
                "SALTS_UTILS_HOST_LEMON_EXECUTABLE": "${sourceDir}/build/ci-host/bin/lemon"
            }
        },
        {
            "name": "win-sdk-package-user",
            "inherits": "win-release-user",
            "binaryDir": "${sourceDir}/build/Msvc-SDK-Release",
            "cacheVariables": {
                "BUILD_TESTS": false,
                "BUILD_BENCHMARKS": false,
                "BUILD_EXAMPLES": false,
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/stage/sdk/windows-x64"
            },
            "environment": {
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc-SDK-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$penv{PATH}"
            }
        },
        {
            "name": "ci-linux-paths",
            "hidden": true,
            "inherits": [
                "vcpkg-cache-ci",
                "pkg-vcpkg"
            ],
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "SALTS_UTILS_ENABLE_CAPTURE": false,
                "BUILD_TESTS": true,
                "BUILD_BENCHMARKS": true,
                "BUILD_EXAMPLES": false
            },
            "environment": {
                "PKG_ROOT": "${sourceDir}/stage/ci-packages",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            }
        },
        {
            "name": "ci-linux-release-user",
            "inherits": [
                "release-linux-ninja",
                "ci-linux-paths"
            ],
            "binaryDir": "${sourceDir}/build/ci-linux-release",
            "cacheVariables": {
                "BUILD_TESTS": true,
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/release",
                "ENABLE_SANITIZER_ADDRESS": false,
                "ENABLE_SANITIZER_UNDEFINED": false
            },
            "environment": {
                "SALTS_ROOT": "$penv{SALTS_ROOT}",
                "LD_LIBRARY_PATH": "${sourceDir}/build/ci-linux-release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            }
        },
        {
            "name": "ci-linux-dev-user",
            "inherits": [
                "dev-linux-ninja",
                "ci-linux-paths"
            ],
            "binaryDir": "${sourceDir}/build/ci-linux-dev",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/debug",
                "ENABLE_SANITIZER_ADDRESS": true,
                "ENABLE_SANITIZER_UNDEFINED": true,
                "CMAKE_SUPPRESS_REGENERATION": true
            },
            "environment": {
                "SALTS_ROOT": "$penv{SALTS_ROOT}",
                "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1",
                "LD_LIBRARY_PATH": "${sourceDir}/build/ci-linux-dev/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            }
        },
        {
            "name": "win-toolchain",
            "hidden": true,
            "environment": {
                "PROJECT_ROOT": "$penv{PROJECT_ROOT}",
                "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
                "VCPKG_ROOT": "$penv{VCPKG_ROOT}",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            },
            "inherits": "vcpkg-cache-windows"
        },
        {
            "name": "win-paths",
            "hidden": true,
            "inherits": "win-toolchain",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "PKG_CONFIG_EXECUTABLE": "${sourceDir}/vcpkg_installed/x64-windows/tools/pkgconf/pkgconf.exe",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_MANIFEST_MODE": "ON",
                "VCPKG_APPLOCAL_DEPS": "OFF",
                "SALTS_UTILS_ENABLE_CAPTURE": "ON",
                "VCPKG_MANIFEST_FEATURES": "capture"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        },
        {
            "name": "linux-paths",
            "hidden": true,
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "environment": {
                "PROJECT_ROOT": "$penv{PROJECT_ROOT}",
                "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
                "VCPKG_ROOT": "$penv{VCPKG_ROOT}",
                "RE2C_ROOT": "$penv{RE2C_ROOT}",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            },
            "inherits": "vcpkg-cache-linux"
        },
        {
            "name": "android-win-environment",
            "hidden": true,
            "inherits": "win-toolchain",
            "cacheVariables": {
                "SALTS_UTILS_HOST_LEMON_EXECUTABLE": "${sourceDir}/build/Msvc-Release/bin/lemon.exe"
            },
            "environment": {
                "ANDROID_SDK_ROOT": "$penv{LOCALAPPDATA}/Android/Sdk",
                "ANDROID_NDK_VERSION": "28.2.13676358",
                "ANDROID_NDK_HOME": "$env{ANDROID_SDK_ROOT}/ndk/$env{ANDROID_NDK_VERSION}"
            }
        },
        {
            "name": "android-dependencies-debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils-android/debug",
                "SALTS_UTILS_ENABLE_CAPTURE": "ON",
                "VCPKG_MANIFEST_FEATURES": "capture"
            },
            "environment": {
                "SALTS_ROOT": "$penv{SALTS_ROOT}"
            }
        },
        {
            "name": "android-dependencies-release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils-android/release",
                "SALTS_UTILS_ENABLE_CAPTURE": "ON",
                "VCPKG_MANIFEST_FEATURES": "capture"
            },
            "environment": {
                "SALTS_ROOT": "$penv{SALTS_ROOT}"
            }
        },
        {
            "name": "win-dev-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/debug"
            },
            "environment": {
                "SALTS_ROOT": "$penv{SALTS_ROOT}",
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-dev-user",
                "win-paths"
            ]
        },
        {
            "name": "win-release-user",
            "cacheVariables": {
                "BUILD_TESTS": true,
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/release"
            },
            "environment": {
                "SALTS_ROOT": "${sourceDir}/stage/dependencies/salts/windows-x64",
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-release-user",
                "win-paths"
            ]
        },
        {
            "name": "win-capture-dev-user",
            "binaryDir": "${sourceDir}/build/Msvc-Capture",
            "environment": {
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc-Capture/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": "win-dev-user"
        },
        {
            "name": "win-capture-release-user",
            "binaryDir": "${sourceDir}/build/Msvc-Capture-Release",
            "environment": {
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc-Capture-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": "win-release-user"
        },
        {
            "name": "linux-dev-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/debug"
            },
            "environment": {
                "SALTS_ROOT": "$penv{SALTS_ROOT}",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": [
                "base-linux-dev-user",
                "linux-paths"
            ]
        },
        {
            "name": "linux-capture-dev-user",
            "binaryDir": "${sourceDir}/build/linux-gcc-capture-debug",
            "cacheVariables": {
                "SALTS_UTILS_ENABLE_CAPTURE": "ON",
                "VCPKG_MANIFEST_FEATURES": "capture"
            },
            "environment": {
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-capture-debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": "linux-dev-user"
        },
        {
            "name": "linux-release-user",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/release"
            },
            "environment": {
                "SALTS_ROOT": "${sourceDir}/stage/dependencies/salts/linux-x64",
                "RE2C_ROOT": "$penv{RE2C_ROOT}",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": [
                "release-linux-ninja",
                "linux-paths"
            ]
        },
        {
            "name": "linux-capture-release-user",
            "binaryDir": "${sourceDir}/build/linux-gcc-capture-release",
            "cacheVariables": {
                "SALTS_UTILS_ENABLE_CAPTURE": "ON",
                "VCPKG_MANIFEST_FEATURES": "capture"
            },
            "environment": {
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-capture-release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": "linux-release-user"
        },
        {
            "name": "linux-sdk-package",
            "binaryDir": "${sourceDir}/build/linux-gcc-sdk-package",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/release",
                "ENABLE_SANITIZER_ADDRESS": "OFF",
                "BUILD_TESTS": "OFF",
                "BUILD_EXAMPLES": "OFF"
            },
            "environment": {
                "SALTS_ROOT": "${sourceDir}/stage/dependencies/salts/linux-x64",
                "RE2C_ROOT": "$penv{RE2C_ROOT}"
            },
            "inherits": [
                "release-linux-ninja",
                "linux-paths"
            ]
        },
        {
            "name": "android-arm64-v8a-debug-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-arm64-v8a-debug"
            },
            "inherits": [
                "android-arm64-v8a-debug",
                "android-win-paths",
                "android-win-environment",
                "android-dependencies-debug"
            ]
        },
        {
            "name": "android-arm64-v8a-release-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-arm64-v8a-release"
            },
            "inherits": [
                "android-arm64-v8a-release",
                "android-win-paths",
                "android-win-environment",
                "android-dependencies-release"
            ]
        },
        {
            "name": "android-x86_64-debug-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-x86_64-debug"
            },
            "inherits": [
                "android-x86_64-debug",
                "android-win-paths",
                "android-win-environment",
                "android-dependencies-debug"
            ]
        },
        {
            "name": "android-x86_64-release-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-x86_64-release"
            },
            "inherits": [
                "android-x86_64-release",
                "android-win-paths",
                "android-win-environment",
                "android-dependencies-release"
            ]
        },
        {
            "name": "android-x86-debug-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-x86-debug"
            },
            "inherits": [
                "android-x86-debug",
                "android-win-paths",
                "android-win-environment",
                "android-dependencies-debug"
            ]
        },
        {
            "name": "android-x86-release-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-x86-release"
            },
            "inherits": [
                "android-x86-release",
                "android-win-paths",
                "android-win-environment",
                "android-dependencies-release"
            ]
        },
        {
            "name": "win-clang-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "OFF",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/debug"
            },
