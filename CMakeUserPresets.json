{
    "version": 6,
    "include": [
        "CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "vcpkg-cache",
            "hidden": true,
            "toolchainFile": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/cmake/QigaoVcpkgToolchain.cmake",
            "environment": {
                "VCPKG_BINARY_SOURCES": "clear;default,readwrite",
                "VCPKG_OVERLAY_PORTS": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/ports",
                "RE2C_ROOT": "$penv{RE2C_ROOT}",
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}$penv{PATH}"
            }
        },
        {
            "name": "vcpkg-cache-windows",
            "hidden": true,
            "inherits": "vcpkg-cache",
            "cacheVariables": {
                "VCPKG_HOST_TRIPLET": "x64-windows"
            },
            "environment": {
                "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{LOCALAPPDATA}/qigao/vcpkg-cache",
                "RE2C_ROOT": "$env{PKG_ROOT}/re2c/windows-x64"
            }
        },
        {
            "name": "vcpkg-cache-linux",
            "hidden": true,
            "inherits": "vcpkg-cache",
            "cacheVariables": {
                "VCPKG_HOST_TRIPLET": "x64-linux"
            },
            "environment": {
                "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{HOME}/.cache/qigao/vcpkg-cache"
            }
        },
        {
            "name": "vcpkg-cache-ci",
            "hidden": true,
            "inherits": "vcpkg-cache",
            "cacheVariables": {
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
            },
            "environment": {
                "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{VCPKG_CACHE_REPOSITORY_ROOT}",
                "VCPKG_BINARY_SOURCES": "$penv{VCPKG_BINARY_SOURCES}",
                "VCPKG_OVERLAY_PORTS": "$penv{VCPKG_OVERLAY_PORTS}"
            }
        },
        {
            "name": "ci-native-paths",
            "hidden": true,
            "inherits": [
                "vcpkg-cache-ci",
                "pkg-vcpkg"
            ],
            "generator": "Ninja",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "VCPKG_TARGET_TRIPLET": "$env{QIGAO_TARGET_TRIPLET}",
                "VCPKG_HOST_TRIPLET": "$env{QIGAO_HOST_TRIPLET}"
            },
            "environment": {
                "PKG_ROOT": "${sourceDir}/stage",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
                "SALTS_UTILS_CI_BUILD_ROOT": "${sourceDir}/build/ci-sdk/$env{QIGAO_SDK_RID}"
            }
        },
        {
            "name": "ci-release-base",
            "hidden": true,
            "inherits": [
                "ci-native-paths",
                "release-mode"
            ],
            "binaryDir": "$env{SALTS_UTILS_CI_BUILD_ROOT}",
            "description": "Shared release-mode base for the LLVM CI graph.",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{QIGAO_TARGET_TOOLCHAIN_FILE}",
                "BUILD_TESTS": false,
                "BUILD_BENCHMARKS": false,
                "BUILD_EXAMPLES": false,
                "ENABLE_SANITIZER_ADDRESS": false,
                "ENABLE_SANITIZER_UNDEFINED": false
            },
            "environment": {
                "SALTSCORE_ROOT": "$penv{SALTSCORE_ROOT}",
                "CMETA_ROOT": "$penv{CMETA_ROOT}",
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}$env{SALTS_UTILS_CI_BUILD_ROOT}/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/bin${pathListSep}$env{CMETA_ROOT}/bin${pathListSep}$env{SALTSCORE_ROOT}/bin${pathListSep}$penv{PATH}",
                "LD_LIBRARY_PATH": "$env{SALTS_UTILS_CI_BUILD_ROOT}/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/lib${pathListSep}$env{CMETA_ROOT}/lib${pathListSep}$env{SALTSCORE_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
                "DYLD_LIBRARY_PATH": "$env{SALTS_UTILS_CI_BUILD_ROOT}/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{QIGAO_TARGET_TRIPLET}/lib${pathListSep}$env{CMETA_ROOT}/lib${pathListSep}$env{SALTSCORE_ROOT}/lib${pathListSep}$penv{DYLD_LIBRARY_PATH}"
            }
        },
        {
            "name": "ci-host-base",
            "hidden": true,
            "inherits": "ci-release-base",
            "binaryDir": "${sourceDir}/build/ci-host",
            "cacheVariables": {
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{QIGAO_HOST_TOOLCHAIN_FILE}"
            },
            "environment": {
                "QIGAO_TARGET_TRIPLET": "$env{QIGAO_HOST_TRIPLET}",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed-host",
                "SALTSCORE_ROOT": "$penv{SALTSCORE_HOST_ROOT}",
                "CMETA_ROOT": "$penv{CMETA_HOST_ROOT}",
                "SALTS_UTILS_CI_BUILD_ROOT": "${sourceDir}/build/ci-host",
                "X_VCPKG_NUGET_ID_PREFIX": ""
            }
        },
        {
            "name": "ci-android-base",
            "hidden": true,
            "inherits": "ci-release-base",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Android",
                "VCPKG_HOST_TRIPLET": "$env{QIGAO_HOST_TRIPLET}",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{QIGAO_TARGET_TOOLCHAIN_FILE}",
                "ANDROID_ABI": "$env{QIGAO_ANDROID_ABI}",
                "ANDROID_PLATFORM": "android-26",
                "ANDROID_STL": "c++_shared",
                "SALTS_UTILS_HOST_LEMON_EXECUTABLE": "${sourceDir}/build/ci-host/bin/lemon"
            }
        },
        {
            "name": "win-toolchain",
            "hidden": true,
            "environment": {
                "PROJECT_ROOT": "$penv{PROJECT_ROOT}",
                "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
                "VCPKG_ROOT": "$penv{VCPKG_ROOT}",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            },
            "inherits": "vcpkg-cache-windows"
        },
        {
            "name": "win-paths",
            "hidden": true,
            "inherits": "win-toolchain",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "PKG_CONFIG_EXECUTABLE": "${sourceDir}/vcpkg_installed/x64-windows/tools/pkgconf/pkgconf.exe",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_MANIFEST_MODE": "ON",
                "VCPKG_APPLOCAL_DEPS": "OFF"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        },
        {
            "name": "linux-paths",
            "hidden": true,
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "environment": {
                "PROJECT_ROOT": "$penv{PROJECT_ROOT}",
                "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
                "VCPKG_ROOT": "$penv{VCPKG_ROOT}",
                "RE2C_ROOT": "$penv{RE2C_ROOT}",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            },
            "inherits": "vcpkg-cache-linux"
        },
        {
            "name": "android-win-environment",
            "hidden": true,
            "inherits": "win-toolchain",
            "cacheVariables": {
                "SALTS_UTILS_HOST_LEMON_EXECUTABLE": "${sourceDir}/build/Msvc-Release/bin/lemon.exe"
            },
            "environment": {
                "ANDROID_SDK_ROOT": "$penv{LOCALAPPDATA}/Android/Sdk",
                "ANDROID_NDK_VERSION": "28.2.13676358",
                "ANDROID_NDK_HOME": "$env{ANDROID_SDK_ROOT}/ndk/$env{ANDROID_NDK_VERSION}"
            }
        },
        {
            "name": "android-dependencies-debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils-android/debug"
            },
            "environment": {
                "SALTSCORE_ROOT": "$penv{SALTSCORE_ROOT}",
                "CMETA_ROOT": "$penv{CMETA_ROOT}"
            }
        },
        {
            "name": "android-dependencies-release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils-android/release"
            },
            "environment": {
                "SALTSCORE_ROOT": "$penv{SALTSCORE_ROOT}",
                "CMETA_ROOT": "$penv{CMETA_ROOT}"
            }
        },
        {
            "name": "win-dev-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/debug"
            },
            "environment": {
                "SALTSCORE_ROOT": "$penv{SALTSCORE_ROOT}",
                "CMETA_ROOT": "$penv{CMETA_ROOT}",
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{CMETA_ROOT}/bin${pathListSep}$env{SALTSCORE_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-dev-user",
                "win-paths"
            ]
        },
        {
            "name": "win-release-user",
            "cacheVariables": {
                "BUILD_TESTS": true,
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/release"
            },
            "environment": {
                "SALTSCORE_ROOT": "${sourceDir}/stage/dependencies/saltscore/windows-x64",
                "CMETA_ROOT": "${sourceDir}/stage/dependencies/cmeta/windows-x64",
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{CMETA_ROOT}/bin${pathListSep}$env{SALTSCORE_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-release-user",
                "win-paths"
            ]
        },
        {
            "name": "linux-dev-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/debug"
            },
            "environment": {
                "SALTSCORE_ROOT": "$penv{SALTSCORE_ROOT}",
                "CMETA_ROOT": "$penv{CMETA_ROOT}",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{CMETA_ROOT}/lib${pathListSep}$env{SALTSCORE_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": [
                "base-linux-dev-user",
                "linux-paths"
            ]
        },
        {
            "name": "linux-release-user",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/release"
            },
            "environment": {
                "SALTSCORE_ROOT": "${sourceDir}/stage/dependencies/saltscore/linux-x64",
                "CMETA_ROOT": "${sourceDir}/stage/dependencies/cmeta/linux-x64",
                "RE2C_ROOT": "$penv{RE2C_ROOT}",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{CMETA_ROOT}/lib${pathListSep}$env{SALTSCORE_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": [
                "release-linux-ninja",
                "linux-paths"
            ]
        },
        {
            "name": "android-arm64-v8a-debug-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-arm64-v8a-debug"
            },
            "inherits": [
                "android-arm64-v8a-debug",
                "android-win-paths",
                "android-win-environment",
                "android-dependencies-debug"
            ]
        },
        {
            "name": "android-arm64-v8a-release-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-arm64-v8a-release"
            },
            "inherits": [
                "android-arm64-v8a-release",
                "android-win-paths",
                "android-win-environment",
                "android-dependencies-release"
            ]
        },
        {
            "name": "android-x86_64-debug-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-x86_64-debug"
            },
            "inherits": [
                "android-x86_64-debug",
                "android-win-paths",
                "android-win-environment",
                "android-dependencies-debug"
            ]
        },
        {
            "name": "android-x86_64-release-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-x86_64-release"
            },
            "inherits": [
                "android-x86_64-release",
                "android-win-paths",
                "android-win-environment",
                "android-dependencies-release"
            ]
        },
        {
            "name": "android-x86-debug-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-x86-debug"
            },
            "inherits": [
                "android-x86-debug",
                "android-win-paths",
                "android-win-environment",
                "android-dependencies-debug"
            ]
        },
        {
            "name": "android-x86-release-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-x86-release"
            },
            "inherits": [
                "android-x86-release",
                "android-win-paths",
                "android-win-environment",
                "android-dependencies-release"
            ]
        },
        {
            "name": "win-clang-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "OFF",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/debug"
            },
            "environment": {
                "SALTSCORE_ROOT": "$penv{SALTSCORE_ROOT}",
                "CMETA_ROOT": "$penv{CMETA_ROOT}",
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Clang/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{CMETA_ROOT}/bin${pathListSep}$env{SALTSCORE_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-dev-clang-user",
                "win-paths"
            ]
        },
        {
            "name": "win-clang-release-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "OFF",
                "BUILD_TESTS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/release"
            },
            "environment": {
                "SALTSCORE_ROOT": "${sourceDir}/stage/dependencies/saltscore/windows-x64",
                "CMETA_ROOT": "${sourceDir}/stage/dependencies/cmeta/windows-x64",
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Clang-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{CMETA_ROOT}/bin${pathListSep}$env{SALTSCORE_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-release-clang-user",
                "win-paths"
            ]
        },
        {
            "name": "ci-native-base",
            "hidden": true,
            "inherits": "ci-release-base",
            "cacheVariables": {
                "BUILD_TESTS": true,
                "BUILD_BENCHMARKS": true,
                "CMAKE_SUPPRESS_REGENERATION": true
            }
        },
        {
            "name": "ci-native",
            "displayName": "CI native LLVM full graph",
            "inherits": "ci-native-base"
        },
        {
            "name": "ci-host",
            "displayName": "CI Android host tools",
            "inherits": "ci-host-base"
        },
        {
            "name": "ci-android",
            "displayName": "CI Android LLVM full graph",
            "inherits": "ci-android-base"
        }
    ],
    "buildPresets": [
        {
            "name": "ci-native",
            "configurePreset": "ci-native"
        },
        {
            "name": "ci-host",
            "configurePreset": "ci-host"
        },
        {
            "name": "ci-android",
            "configurePreset": "ci-android"
        },
