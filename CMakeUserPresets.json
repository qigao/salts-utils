            },
            "inherits": [
                "android-x86-release",
                "android-win-paths",
                "android-win-environment",
                "android-dependencies-release"
            ]
        },
        {
            "name": "win-clang-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "OFF",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/debug"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
                "PATH": "${sourceDir}/build/Clang/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-dev-clang-user",
                "win-paths"
            ]
        },
        {
            "name": "win-clang-release-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "OFF",
                "ENABLE_TESTS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/salts-utils/release"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
                "PATH": "${sourceDir}/build/Clang-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-release-clang-user",
                "win-paths"
            ]
        }
