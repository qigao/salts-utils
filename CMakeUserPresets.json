    "testPresets": [
        {
            "name": "ci-native",
            "configurePreset": "ci-native",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "win-dev-user",
            "inherits": "base-test",
            "configurePreset": "win-dev-user"
        },
        {
            "name": "win-release-user",
            "inherits": "base-test",
